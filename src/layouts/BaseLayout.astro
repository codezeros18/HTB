---
/**
 * BaseLayout — kerangka <html> untuk seluruh halaman.
 *
 * Isi <head> berasal dari `site.ts` (guardrail 5). SATU font untuk
 * seluruh situs — Plus Jakarta Sans (self-host, subset latin di-preload).
 * Nol request pihak ketiga (guardrail 6).
 *
 * Props:
 *   title        judul halaman. Default `site.meta.title`.
 *   description  meta description. Default `site.meta.description`.
 *   noindex      kirim `robots: noindex`. Default false.
 *   ogImage      path absolut gambar OG. Default null → tag og:image
 *                & twitter:image TIDAK dirender. Berkasnya dibuat di
 *                S10/T10.1; merujuk berkas yang belum ada lebih buruk
 *                daripada tidak ada tag sama sekali.
 *   jsonLd       sisipkan blok JSON-LD. Default true (matikan di 404).
 *   heroNav      homepage — navbar mulai tersembunyi, muncul setelah hero
 *                tergeser lewat (REDESIGN 2026-09-06). Default false.
 */
import { site } from '../content/site';
import SkipLink from '../components/layout/SkipLink.astro';
import Navbar from '../components/layout/Navbar.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import StructuredData from '../components/layout/StructuredData.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string | null;
  jsonLd?: boolean;
  heroNav?: boolean;
}

const {
  title = site.meta.title,
  description = site.meta.description,
  noindex = false,
  ogImage = null,
  jsonLd = true,
  heroNav = false,
}: Props = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://motive.example').href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* REDESIGN 2026-08-31 — favicon dari mark "////" logo MOTIVE (dulu
        nol favicon sama sekali → tab browser pakai ikon generik). Wordmark
        asli terlalu lebar (rasio ~7,7:1) untuk kotak favicon, jadi dipotong
        ke bagian mark-nya saja + latar warna brand `--color-bg`. */
    }
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      /* REDESIGN (2026-09-04) — SATU font: Plus Jakarta Sans, SELF-HOST.
        Subset latin di-preload (paling umum); latin-ext dimuat on-demand
        oleh @font-face di global.css. Nol Google Fonts, nol preconnect
        pihak ketiga. */
    }
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, canonical).href} />}

    {/* Twitter Card — summary_large_image hanya bermakna kalau ada gambar. */}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, canonical).href} />}

    {
      /* `theme-color` sengaja TIDAK dipasang. Atribut HTML tidak bisa
        membaca custom property, jadi nilainya harus hex literal —
        melanggar guardrail 4 dan diam-diam tetap putih kalau palet
        ditukar ke Arah B. Ditambahkan di S10 saat arah desain final,
        dengan komentar yang menautkannya ke --color-bg di tokens.css. */
    }

    {jsonLd && <StructuredData canonical={canonical} />}
  </head>

  <body id="top">
    <SkipLink />
    <Navbar heroNav={heroNav} />
    <MobileMenu />

    <main id="konten-utama">
      <slot />
    </main>

    <Footer />

    <script>
      import { revealOnScroll } from '../scripts/observer';
      revealOnScroll();
    </script>
  </body>
</html>
