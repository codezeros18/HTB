---
/**
 * /layanan/[layanan]/[sub]/ — daftar produk dalam satu kelompok.
 * REDESIGN 2026-08-30 — lihat catatan di `/layanan/[layanan]/index.astro`.
 */
import type { Layanan, LayananSub } from '../../../../content/layanan';
import { layanan } from '../../../../content/layanan';
import { site } from '../../../../content/site';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Container from '../../../../components/layout/Container.astro';
import LayananCrumb from '../../../../components/layanan/LayananCrumb.astro';
import type { Crumb } from '../../../../components/layanan/LayananCrumb.astro';

interface StaticProps {
  l: Layanan;
  s: LayananSub;
}

export function getStaticPaths(): {
  params: { layanan: string; sub: string };
  props: StaticProps;
}[] {
  return layanan.flatMap((l) =>
    l.sub.map((s) => ({ params: { layanan: l.slug, sub: s.slug }, props: { l, s } }))
  );
}

const { l, s } = Astro.props as StaticProps;

const trail: Crumb[] = [
  { label: 'Beranda', href: '/#produk' },
  { label: 'Our Services', href: '/#produk' },
  // Layanan 1-kelompok melompati tingkat ini di homepage — nama kelompoknya
  // ("Komponen Racepack" dst.) tidak berguna sebagai remah roti terpisah.
  ...(l.sub.length > 1
    ? [{ label: l.nama, href: `/layanan/${l.slug}` }, { label: s.nama }]
    : [{ label: l.nama }]),
];
---

<BaseLayout
  title={`${s.nama} — ${l.nama} — ${site.brand}`}
  description={`Pilihan produk ${s.nama} dari layanan ${l.nama} ${site.brand}.`}
>
  <Container as="section" spacing="section" last>
    <LayananCrumb trail={trail} />

    <p class="t-eyebrow lyn__eyebrow">{l.nama}</p>
    <h1 class="t-h1 lyn__judul">{s.nama}</h1>

    <div class="lyn__grid">
      {
        s.items.map((it) => (
          <a class="lyn__tile" href={`/layanan/${l.slug}/${s.slug}/${it.slug}`}>
            <span class="lyn__tile-media">
              <img
                src={it.foto}
                alt={it.nama}
                width={it.width}
                height={it.height}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="lyn__tile-teks">
              <span class="lyn__tile-nama t-h3">{it.nama}</span>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</BaseLayout>

<style>
  .lyn__eyebrow {
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }

  .lyn__judul {
    color: var(--color-text);
    margin: 0 0 var(--space-7);
  }

  .lyn__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .lyn__tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
    overflow: hidden;
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .lyn__tile:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .lyn__tile:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .lyn__tile-media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .lyn__tile-media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .lyn__tile-teks {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
  }

  .lyn__tile-nama {
    color: var(--color-text);
  }

  @media (max-width: 1023.98px) {
    .lyn__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767.98px) {
    .lyn__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
