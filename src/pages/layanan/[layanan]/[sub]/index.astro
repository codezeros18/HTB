---
/**
 * /layanan/[layanan]/[sub]/ — daftar produk dalam satu kelompok.
 * REDESIGN 2026-08-30 — lihat catatan di `/layanan/[layanan]/index.astro`.
 */
import type { Layanan, LayananSub } from '../../../../content/layanan';
import { layanan } from '../../../../content/layanan';
import { site } from '../../../../content/site';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Container from '../../../../components/layout/Container.astro';
import LayananCrumb from '../../../../components/layanan/LayananCrumb.astro';
import LayananTile from '../../../../components/layanan/LayananTile.astro';
import type { Crumb } from '../../../../components/layanan/LayananCrumb.astro';

interface StaticProps {
  l: Layanan;
  s: LayananSub;
}

export function getStaticPaths(): {
  params: { layanan: string; sub: string };
  props: StaticProps;
}[] {
  return layanan.flatMap((l) =>
    l.sub.map((s) => ({ params: { layanan: l.slug, sub: s.slug }, props: { l, s } }))
  );
}

const { l, s } = Astro.props as StaticProps;

const trail: Crumb[] = [
  { label: 'Beranda', href: '/#produk' },
  { label: 'Our Services', href: '/#produk' },
  // Layanan 1-kelompok melompati tingkat ini di homepage — nama kelompoknya
  // ("Komponen Racepack" dst.) tidak berguna sebagai remah roti terpisah.
  ...(l.sub.length > 1
    ? [{ label: l.nama, href: `/layanan/${l.slug}` }, { label: s.nama }]
    : [{ label: l.nama }]),
];
---

<BaseLayout
  title={`${s.nama} — ${l.nama} — ${site.brand}`}
  description={`Pilihan produk ${s.nama} dari layanan ${l.nama} ${site.brand}.`}
>
  <Container as="section" spacing="section" last>
    <LayananCrumb trail={trail} />

    <p class="t-eyebrow lyn__eyebrow">{l.nama}</p>
    <h1 class="t-h1 lyn__judul">{s.nama}</h1>

    <div class="lyn__grid">
      {
        s.items.map((it) => (
          <LayananTile
            href={`/layanan/${l.slug}/${s.slug}/${it.slug}`}
            foto={it.foto}
            nama={it.nama}
            width={it.width}
            height={it.height}
            cta="Lihat Detail"
          />
        ))
      }
    </div>
  </Container>
</BaseLayout>

<style>
  .lyn__eyebrow {
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }

  .lyn__judul {
    color: var(--color-text);
    margin: 0 0 var(--space-7);
  }

  .lyn__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 1023.98px) {
    .lyn__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767.98px) {
    .lyn__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
