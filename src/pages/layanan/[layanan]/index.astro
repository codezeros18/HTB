---
/**
 * /layanan/[layanan]/ — daftar kelompok dalam satu layanan.
 * REDESIGN 2026-08-30: menggantikan panel drill-down di homepage dengan
 * halaman statis sungguhan (getStaticPaths — nol server, tetap prebuilt).
 *
 * Layanan dengan HANYA SATU kelompok tidak ditautkan ke sini dari homepage
 * (kartunya langsung ke `/layanan/[layanan]/[sub]`) — tapi halaman ini
 * tetap di-generate untuk semuanya supaya URL-nya tidak pernah 404.
 */
import type { Layanan } from '../../../content/layanan';
import { layanan } from '../../../content/layanan';
import { site } from '../../../content/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/layout/Container.astro';
import LayananCrumb from '../../../components/layanan/LayananCrumb.astro';

interface StaticProps {
  l: Layanan;
}

export function getStaticPaths(): { params: { layanan: string }; props: StaticProps }[] {
  return layanan.map((l) => ({ params: { layanan: l.slug }, props: { l } }));
}

const { l } = Astro.props as StaticProps;
---

<BaseLayout
  title={`${l.nama} — ${site.brand}`}
  description={`${l.ringkas} Lihat pilihan produk ${l.nama} dari ${site.brand}.`}
>
  <Container as="section" spacing="section" last>
    <LayananCrumb
      trail={[
        { label: 'Beranda', href: '/#produk' },
        { label: 'Our Services', href: '/#produk' },
        { label: l.nama },
      ]}
    />

    <p class="t-eyebrow lyn__eyebrow">Layanan Kami</p>
    <h1 class="t-h1 lyn__judul">{l.nama}</h1>
    <p class="t-body-l lyn__ringkas">{l.ringkas}</p>

    <div class="lyn__grid">
      {
        l.sub.map((s) => (
          <a class="lyn__tile" href={`/layanan/${l.slug}/${s.slug}`}>
            <span class="lyn__tile-media">
              <img
                src={s.foto}
                alt={s.nama}
                width="1054"
                height="1492"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="lyn__tile-teks">
              <span class="lyn__tile-nama t-h3">{s.nama}</span>
              <span class="lyn__tile-meta t-body-s">{s.items.length} produk</span>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</BaseLayout>

<style>
  .lyn__eyebrow {
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }

  .lyn__judul {
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .lyn__ringkas {
    color: var(--color-text-2);
    max-inline-size: 60ch;
    margin: 0 0 var(--space-7);
  }

  .lyn__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .lyn__tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
    overflow: hidden;
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .lyn__tile:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .lyn__tile:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .lyn__tile-media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .lyn__tile-media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .lyn__tile-teks {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
  }

  .lyn__tile-nama {
    color: var(--color-text);
  }

  .lyn__tile-meta {
    color: var(--color-text-2);
  }

  @media (max-width: 1023.98px) {
    .lyn__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767.98px) {
    .lyn__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
