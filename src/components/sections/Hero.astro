---
/**
 * Hero — REDESIGN 2026-08-30 (permintaan klien, iterasi 2).
 *
 * Kombinasi PUTIH + EMAS, bukan monokrom:
 *   - eyebrow  : emas   (aksen kecil di atas)
 *   - garis    : emas   (rule 64px)
 *   - headline : putih  (massa teks utama)
 *   - deskripsi: muted / putih di atas foto
 *   - CTA      : SATU tombol emas solid — titik warna yang bikin hero "hidup"
 *
 * Semua rata tengah. Field lama di `site.hero` dipertahankan (kontrak tipe).
 * Guardrail 9 tetap: hero TIDAK dianimasikan masuk.
 */
import { site } from '../../content/site';
import Container from '../layout/Container.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { hero } = site;
const varian = hero.fotoTersedia && hero.fotoSrc ? 'foto' : 'tanpa-foto';
---

<section id={id} class="mv-hero" data-varian={varian}>
  {
    varian === 'foto' && hero.fotoSrc && (
      <>
        <link rel="preload" as="image" href={hero.fotoSrc} fetchpriority="high" />
        <img
          class="mv-hero__foto"
          src={hero.fotoSrc}
          alt={hero.fotoAlt ?? ''}
          width="1536"
          height="1024"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <div class="mv-hero__overlay" aria-hidden="true" />
      </>
    )
  }

  <Container as="div" class="mv-hero__inner">
    <p class="mv-hero__eyebrow t-eyebrow">{hero.eyebrow}</p>
    <span class="mv-hero__rule" aria-hidden="true"></span>
    <h1 class="mv-hero__h1 t-display">{hero.h1}</h1>
    <p class="mv-hero__sub t-body-l">{hero.sub}</p>
    <div class="mv-hero__cta">
      <WhatsAppButton konteks="hero" label={hero.ctaPrimer} size="lg" />
    </div>
  </Container>
</section>

<style>
  .mv-hero {
    --hero-ink: rgb(255 255 255);
    --hero-overlay: var(--modal-backdrop);

    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    /* Hero full-screen. Navbar transparan menumpang di atasnya. */
    min-height: 100vh;
  }

  @media (max-width: 767.98px) {
    .mv-hero {
      min-height: 100svh;
    }
  }

  .mv-hero__foto {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .mv-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--hero-overlay);
  }

  .mv-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-inline-size: 64rem;
    margin-inline: auto;
    padding-block: var(--space-8);
    gap: var(--space-4);
  }

  /* Aksen emas — dipakai kecil-kecil, bukan di seluruh teks. */
  .mv-hero__eyebrow {
    color: var(--color-accent);
    margin: 0;
  }

  .mv-hero__rule {
    inline-size: 64px;
    block-size: 2px;
    background-color: var(--color-accent);
    margin-block: var(--space-2);
  }

  /* Headline PUTIH — massa teks utama. */
  .mv-hero__h1 {
    color: var(--color-text);
    margin: 0;
  }

  .mv-hero__sub {
    color: var(--color-text-2);
    max-inline-size: 54ch;
    margin: 0;
  }

  .mv-hero__cta {
    margin-block-start: var(--space-4);
  }

  /* Varian foto: teks jadi putih terang di atas overlay (headline tetap putih,
     deskripsi & eyebrow tetap terbaca). Eyebrow tetap emas. */
  .mv-hero[data-varian='foto'] .mv-hero__h1,
  .mv-hero[data-varian='foto'] .mv-hero__sub {
    color: var(--hero-ink);
  }

  @media (max-width: 639.98px) {
    .mv-hero__cta > * {
      inline-size: 100%;
    }
  }
</style>
