---
/**
 * Hero — REDESIGN 2026-09-05 (permintaan klien, iterasi 5).
 *
 * Riwayat singkat: mulai dari h1 raksasa + eyebrow + sub + CTA → dipangkas
 * jadi h1 saja di pojok kiri-bawah → dipangkas lagi jadi NOL teks (cuma
 * foto `motive.png`, headline pindah ke About) → SEKARANG: foto asli
 * "Hero Section.png" (lantai produksi) diputihkan (lihat catatan di
 * `site.hero.fotoSrc`), logo MOTIVE hitam ditumpuk di tengah, dan tagline
 * singkat ditaruh di bawah logo — "simple, to the point", bukan display
 * raksasa lagi.
 *
 * Kenapa teks gelap (bukan putih seperti iterasi foto-gelap sebelumnya):
 * latar sekarang terang (foto diputihkan), jadi logo/tagline pakai warna
 * gelap (`--color-bg`, token near-black situs — dipakai terbalik sebagai
 * "tinta gelap" di atas latar terang, bukan hex baru).
 *
 * Guardrail 9 tetap: hero TIDAK dianimasikan masuk — foto LCP dimuat
 * eager + fetchpriority high + di-preload. Chevron isyarat scroll murni
 * CSS; `hero-scroll.ts` cuma memudarkannya saat digeser (listener pasif,
 * nol jank). Scroll halaman 100% native — hijack scroll lama dibuang.
 */
import { site } from '../../content/site';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { hero } = site;
---

<section id={id} class="mv-hero">
  {
    hero.fotoSrc && (
      <>
        <link rel="preload" as="image" href={hero.fotoSrc} fetchpriority="high" />
        <img
          class="mv-hero__foto"
          src={hero.fotoSrc}
          alt={hero.fotoAlt ?? ''}
          width="1536"
          height="1024"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <div class="mv-hero__scrim" aria-hidden="true" />
      </>
    )
  }

  <div class="mv-hero__inner">
    <img
      class="mv-hero__logo"
      src="/images/logo/LOGO%20MOTIVE%20NEW.png"
      alt="MOTIVE"
      width="1700"
      height="215"
      loading="eager"
      decoding="async"
    />
    <p class="mv-hero__tagline">{hero.h1}</p>
  </div>

  <div class="mv-hero__cue" aria-hidden="true">
    <span class="mv-hero__cue-label">Scroll</span>
    <span class="mv-hero__cue-arrow"></span>
  </div>
</section>

<script>
  import { initHeroScroll } from '../../scripts/hero-scroll';
  initHeroScroll();
</script>

<style>
  .mv-hero {
    --hero-ink: var(--color-bg);

    position: relative;
    overflow: hidden;
    /* Hero full-screen. Navbar transparan menumpang di atasnya. */
    min-height: 100vh;
  }

  @media (max-width: 767.98px) {
    .mv-hero {
      min-height: 100svh;
    }
  }

  .mv-hero__foto {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  /* Gradien gelap tipis di ~40% atas frame — jaga kontras tautan navbar
     putih yang menumpang transparan di atas foto yang sekarang terang. */
  .mv-hero__scrim {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 40%;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg) 45%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 14%, transparent) 45%,
      transparent 100%
    );
  }

  .mv-hero__inner {
    /* absolute + inset:0 (bukan flex di .mv-hero + block biasa di sini) —
       block biasa dengan min-block-size:100% TIDAK stretch tanpa parent
       flex/grid, hasilnya kolaps ke tinggi konten dan nempel di ATAS,
       nabrak navbar. absolute+inset:0 pasti mengisi seluruh .mv-hero. */
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    text-align: center;
    padding-inline: var(--edge-pad);
  }

  .mv-hero__logo {
    inline-size: clamp(220px, 26vw, 420px);
    block-size: auto;
  }

  /* Tagline "simple, to the point" — bukan display raksasa seperti
     iterasi sebelumnya, cukup satu baris tenang di bawah logo. */
  .mv-hero__tagline {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(0.8rem, 1.3vw, 1.05rem);
    color: var(--hero-ink);
    margin: 0;
  }

  /* Panduan "scroll ke bawah" — REDESIGN 2026-09-06 (permintaan klien:
     dibuat lebih kelihatan). Dulu cuma chevron 24px tipis; sekarang
     label "SCROLL" + chevron, kontras lebih tinggi. Label diam supaya
     terbaca; hanya chevron yang memantul. Murni CSS.
     Memudar begitu `hero-scroll.ts` menandai [data-scrolled]. */
  .mv-hero__cue {
    position: absolute;
    inset-block-end: clamp(20px, 4vh, 44px);
    inset-inline: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--hero-ink);
    opacity: 0.92;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease);
  }

  .mv-hero__cue-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    /* Huruf terakhir ikut ter-tracking → geser balik supaya benar-benar
       center terhadap chevron di bawahnya. */
    text-indent: 0.28em;
  }

  .mv-hero__cue-arrow {
    position: relative;
    display: block;
    inline-size: 22px;
    block-size: 22px;
  }

  .mv-hero__cue-arrow::before {
    content: '';
    position: absolute;
    inset-block-start: 2px;
    inset-inline: 4px;
    block-size: 12px;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(45deg);
  }

  .mv-hero[data-scrolled] .mv-hero__cue {
    opacity: 0;
  }

  .mv-hero[data-scrolled] .mv-hero__cue-arrow {
    animation: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mv-hero__cue-arrow {
      animation: mv-hero-cue 1.9s var(--ease) infinite;
    }
  }

  @keyframes mv-hero-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(7px);
      opacity: 0.9;
    }
  }
</style>
