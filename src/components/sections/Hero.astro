---
/**
 * Hero — REDESIGN 2026-09-04 (permintaan klien): hero jadi HANYA gambar
 * latar, NOL teks. `motive.png` (hitam-putih) sudah memuat logo MOTIVE di
 * tengah frame, dan headline "KONVEKSI CUSTOM APPAREL & RACEPACK" dipindah
 * ke section About (`about.judul`). Tidak ada lagi h1 / eyebrow / sub /
 * CTA / garis aksen.
 *
 * `mv-hero__scrim` = gradien gelap tipis di ~40% atas frame. Itu BUKAN
 * overlay teks hero (tidak ada teksnya) — fungsinya menjaga keterbacaan
 * tautan navbar (putih) yang menumpang transparan di atas bagian atas
 * `motive.png` yang terang. Guardrail aksesibilitas: kontras navbar wajib
 * lolos.
 *
 * Guardrail 9 tetap: hero TIDAK dianimasikan masuk — gambar LCP dimuat
 * eager + fetchpriority high + di-preload.
 */
import { site } from '../../content/site';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { hero } = site;
---

<section id={id} class="mv-hero">
  {
    hero.fotoSrc && (
      <>
        <link rel="preload" as="image" href={hero.fotoSrc} fetchpriority="high" />
        <img
          class="mv-hero__foto"
          src={hero.fotoSrc}
          alt={hero.fotoAlt ?? ''}
          width="2880"
          height="1608"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <div class="mv-hero__scrim" aria-hidden="true" />
      </>
    )
  }
</section>

<style>
  .mv-hero {
    position: relative;
    overflow: hidden;
    /* Hero full-screen. Navbar transparan menumpang di atasnya. */
    min-height: 100vh;
  }

  @media (max-width: 767.98px) {
    .mv-hero {
      min-height: 100svh;
    }
  }

  .mv-hero__foto {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .mv-hero__scrim {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 40%;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg) 62%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 24%, transparent) 45%,
      transparent 100%
    );
  }
</style>
