---
/**
 * Hero — REDESIGN 2026-09-05 (permintaan klien, iterasi 5).
 *
 * Riwayat singkat: mulai dari h1 raksasa + eyebrow + sub + CTA → dipangkas
 * jadi h1 saja di pojok kiri-bawah → dipangkas lagi jadi NOL teks → foto
 * lantai produksi diputihkan + logo MOTIVE + tagline di bawahnya.
 *
 * REVISI 2026-09-08 (permintaan klien: "di hero pure logo aja hilangin
 * tulisan konveksi"): tagline DIBUANG. Hero kini foto + LOGO SAJA, nol
 * teks. `site.hero.h1` sengaja DIPERTAHANKAN di data — masih dipakai
 * sebagai sumber `<title>`/deskripsi meta lewat site.ts dan biar mudah
 * dikembalikan kalau klien berubah pikiran.
 *
 * Kenapa tinta gelap (bukan putih seperti iterasi foto-gelap sebelumnya):
 * latar sekarang terang (foto diputihkan), jadi isyarat scroll pakai warna
 * gelap (`--color-bg`, token near-black situs — dipakai terbalik sebagai
 * "tinta gelap" di atas latar terang, bukan hex baru).
 *
 * Guardrail 9 tetap: hero TIDAK dianimasikan masuk — foto LCP dimuat
 * eager + fetchpriority high + di-preload. Chevron isyarat scroll murni
 * CSS; `hero-scroll.ts` cuma memudarkannya saat digeser (listener pasif,
 * nol jank). Scroll halaman 100% native — hijack scroll lama dibuang.
 */
import { site } from '../../content/site';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { hero } = site;

/**
 * `srcset` foto hero. Foto ini adalah elemen LCP, dan sumber 1536px
 * (148 KB) adalah penyumbang LCP terbesar di 4G lambat — ponsel 400px
 * tidak perlu mengunduhnya. Varian dibuat oleh `scripts/optimize-images.mjs`
 * (lebar 400/800/1200, WebP q82) di samping berkas aslinya.
 * Diukur di 4G lambat + CPU 4x: LCP turun dari 2,4 s.
 */
const heroSrcset = hero.fotoSrc
  ? [400, 800, 1200]
      .map((w) => `${hero.fotoSrc?.replace('.webp', `-${w}.webp`)} ${w}w`)
      .concat(`${hero.fotoSrc} 1536w`)
      .join(', ')
  : undefined;
---

<section id={id} class="mv-hero">
  {
    hero.fotoSrc && (
      <>
        <link
          rel="preload"
          as="image"
          href={hero.fotoSrc}
          imagesrcset={heroSrcset}
          imagesizes="100vw"
          fetchpriority="high"
        />
        <img
          class="mv-hero__foto"
          src={hero.fotoSrc}
          srcset={heroSrcset}
          sizes="100vw"
          alt={hero.fotoAlt ?? ''}
          width="1536"
          height="1024"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <div class="mv-hero__scrim" aria-hidden="true" />
      </>
    )
  }

  <div class="mv-hero__inner">
    <img
      class="mv-hero__logo"
      src="/images/logo/LOGO%20MOTIVE%20NEW.png"
      alt="MOTIVE"
      width="1700"
      height="215"
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="mv-hero__cue" aria-hidden="true">
    <span class="mv-hero__cue-label">Scroll</span>
    <span class="mv-hero__cue-arrow"></span>
  </div>
</section>

<script>
  import { initHeroScroll } from '../../scripts/hero-scroll';
  initHeroScroll();
</script>

<style>
  .mv-hero {
    --hero-ink: var(--color-bg);

    position: relative;
    overflow: hidden;
    /* Hero full-screen. Navbar transparan menumpang di atasnya. */
    min-height: 100vh;
  }

  @media (max-width: 767.98px) {
    .mv-hero {
      min-height: 100svh;
    }
  }

  .mv-hero__foto {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  /* Gradien gelap tipis di ~40% atas frame — jaga kontras tautan navbar
     putih yang menumpang transparan di atas foto yang sekarang terang. */
  .mv-hero__scrim {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 40%;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg) 45%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 14%, transparent) 45%,
      transparent 100%
    );
  }

  .mv-hero__inner {
    /* absolute + inset:0 (bukan flex di .mv-hero + block biasa di sini) —
       block biasa dengan min-block-size:100% TIDAK stretch tanpa parent
       flex/grid, hasilnya kolaps ke tinggi konten dan nempel di ATAS,
       nabrak navbar. absolute+inset:0 pasti mengisi seluruh .mv-hero. */
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: var(--edge-pad);
  }

  .mv-hero__logo {
    inline-size: clamp(220px, 26vw, 420px);
    block-size: auto;
  }

  /* Panduan "scroll ke bawah" — REDESIGN 2026-09-06 (permintaan klien:
     dibuat lebih kelihatan). Dulu cuma chevron 24px tipis; sekarang
     label "SCROLL" + chevron, kontras lebih tinggi. Label diam supaya
     terbaca; hanya chevron yang memantul. Murni CSS.
     Memudar begitu `hero-scroll.ts` menandai [data-scrolled]. */
  .mv-hero__cue {
    position: absolute;
    inset-block-end: clamp(20px, 4vh, 44px);
    inset-inline: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--hero-ink);
    opacity: 0.92;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease);
  }

  .mv-hero__cue-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    /* Huruf terakhir ikut ter-tracking → geser balik supaya benar-benar
       center terhadap chevron di bawahnya. */
    text-indent: 0.28em;
  }

  .mv-hero__cue-arrow {
    position: relative;
    display: block;
    inline-size: 22px;
    block-size: 22px;
  }

  .mv-hero__cue-arrow::before {
    content: '';
    position: absolute;
    inset-block-start: 2px;
    inset-inline: 4px;
    block-size: 12px;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(45deg);
  }

  .mv-hero[data-scrolled] .mv-hero__cue {
    opacity: 0;
  }

  .mv-hero[data-scrolled] .mv-hero__cue-arrow {
    animation: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mv-hero__cue-arrow {
      animation: mv-hero-cue 1.9s var(--ease) infinite;
    }
  }

  @keyframes mv-hero-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(7px);
      opacity: 0.9;
    }
  }
</style>
