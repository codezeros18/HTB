---
/**
 * Location — REDESIGN 2026-09-06 (permintaan klien): judul section
 * "Tiga Lokasi, Satu Rantai Produksi" DIHAPUS. Tiap lokasi = judul peran
 * bergaya headline emas (di tengah, TERPISAH di atas) + kartu KOTAK
 * (aspect-ratio 1/1, ketiganya identik) berisi peta Leaflet penuh
 * edge-to-edge. Nomor rantai + panah antar-kartu ikut dibuang.
 *
 * Peta dimuat OTOMATIS saat kartu mendekati layar — `location-maps.ts`.
 */
import { lokasi } from '../../content/lokasi';
import Container from '../layout/Container.astro';
import LocationCard from '../cards/LocationCard.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;
---

<Container as="section" spacing="section" id={id}>
  <ol class="mv-lokasi__list">
    {
      lokasi.map((l) => (
        <li class="mv-lokasi__item">
          <LocationCard
            peran={l.peran}
            alamat={l.alamat}
            slug={l.slug}
            lat={l.koordinat?.lat ?? 0}
            lng={l.koordinat?.lng ?? 0}
            mapsUrl={l.mapsUrl}
          />
        </li>
      ))
    }
  </ol>
</Container>

<style>
  .mv-lokasi__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mv-lokasi__item {
    display: flex;
  }

  @media (max-width: 1023.98px) {
    .mv-lokasi__list {
      grid-template-columns: 1fr;
      max-inline-size: 28rem;
      margin-inline: auto;
    }
  }
</style>

<script>
  import { initLocationMaps } from '../../scripts/location-maps';
  initLocationMaps();
</script>
