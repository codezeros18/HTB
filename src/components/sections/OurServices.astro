---
/**
 * OurServices — REDESIGN 2026-08-30 (v3, permintaan klien).
 *
 * Homepage kini HANYA menampilkan kartu ringkasan layanan — kelompok,
 * daftar produk, dan detail dipindah ke halaman sungguhan di
 * `/layanan/[layanan]/**` (lihat folder itu untuk drill-down-nya).
 *
 * Alasan pindah dari panel-dalam-halaman ke halaman asli:
 *   - Homepage tidak lagi memuat 49 panel tersembunyi (dulu ~230KB HTML).
 *   - Tiap produk dapat URL asli — bisa dibagikan langsung via WA/IG.
 *   - Tombol back/forward browser bekerja natural, tanpa JS navigasi.
 *
 * Kartu = tautan `<a>` biasa. NOL JavaScript di section ini.
 */
import { layanan, layananHref } from '../../content/layanan';
import Container from '../layout/Container.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;
---

<Container as="section" spacing="section" id={id}>
  <header class="svc__head">
    <h2 class="svc__title">Our Services</h2>
  </header>

  <div class="svc__cards">
    {
      layanan.map((l) => (
        <a class="svc__card" href={layananHref(l)}>
          <span class="svc__card-media">
            <img
              src={l.foto}
              alt={l.nama}
              width="1054"
              height="1492"
              loading="lazy"
              decoding="async"
            />
            <span class="svc__card-scrim" aria-hidden="true" />
          </span>
          <span class="svc__card-body">
            <span class="svc__card-nama">{l.nama}</span>
            <span class="svc__card-ringkas">{l.ringkas}</span>
            <span class="svc__card-cta" aria-hidden="true">
              Lihat Produk
            </span>
          </span>
        </a>
      ))
    }
  </div>
</Container>

<style>
  .svc__head {
    margin-block-end: var(--space-7);
  }

  .svc__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-accent);
    font-size: clamp(2.75rem, 12vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin: 0;
    overflow: hidden;
  }

  .svc__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  /* REDESIGN 2026-09-01 (referensi satisfyrunning.com, permintaan klien) —
     kartu jadi foto penuh potret dengan isi (judul, deskripsi singkat,
     tombol) DITUMPUK DI TENGAH foto, bukan panel teks terpisah di bawah.
     Jumlah produk & deskripsi panjang dihapus dari tampilan. */
  .svc__card {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease);
  }

  .svc__card:hover {
    transform: translateY(-2px);
  }

  .svc__card:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .svc__card-media {
    position: relative;
    display: block;
    /* Rasio potret tinggi mengikuti referensi (≈1352×2076). */
    aspect-ratio: 1352 / 2076;
    overflow: hidden;
  }

  .svc__card-media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  /* Scrim gelap tipis supaya teks putih di tengah tetap terbaca di foto
     apa pun tanpa perlu overlay warna solid yang menutupi produk. */
  .svc__card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(6, 5, 4, 0.15) 0%,
      rgba(6, 5, 4, 0.05) 35%,
      rgba(6, 5, 4, 0.45) 100%
    );
  }

  .svc__card-body {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .svc__card-nama {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2vw + 1rem, 2.25rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .svc__card-ringkas {
    color: var(--color-text);
    font-size: var(--fs-body-s);
    letter-spacing: 0.02em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  /* Tombol pill — pengecualian sengaja dari aturan "nol rounded" situs:
     elemen CTA kecil di atas foto, bukan kartu/panel, mengikuti spesifikasi
     referensi klien persis (radius 16px pada tinggi ~34px = bentuk pil). */
  .svc__card-cta {
    margin-block-start: var(--space-2);
    display: inline-flex;
    align-items: center;
    background-color: var(--color-text);
    color: var(--color-accent-ink);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding-block: 9px;
    padding-inline: 20px;
    border-radius: 999px;
  }

  @media (max-width: 1023.98px) {
    .svc__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 559.98px) {
    .svc__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
