---
/**
 * About — REDESIGN 2026-09-07 (permintaan klien, iterasi 4).
 *
 * Riwayat: 2 kolom eyebrow+H2 → visual-driven berbasis foto (dibatalkan,
 * foto klien belum ada) → paragraf asimetris (lubang kosong) → rail kiri
 * (masih terasa berat sebelah).
 *
 * Sekarang: layout editorial LURUS, tanpa kolom samping.
 *   1. judul "ABOUT US" (English, sinkron section lain)
 *   2. byline meta di bawah judul — identitas perusahaan sebagai satu
 *      baris kecil beraksen emas (dulu rail kiri yang meninggalkan void)
 *   3. dua paragraf dalam SATU kolom terbaca (maks 64ch), paragraf
 *      pertama sebagai lead (lebih besar & terang)
 *   4. 4 janji nilai BERNOMOR (01–04) sebagai strip lebar bergaris emas
 *
 * Nol lubang kosong, nol baris melar. Section BERBASIS TEKS — foto
 * "tentang kami" milik klien belum tersedia.
 *
 * Semua konten dari `site.about` (guardrail 5). Fade-in: `.mv-reveal`.
 */
import { site } from '../../content/site';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { about } = site;
const [lead, lanjutan] = about.paragraf;
const meta = about.baris.filter((b): b is string => b !== null);
const nomor = (i: number): string => String(i + 1).padStart(2, '0');
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading judul={about.judul} align="start" />

  <div class="mv-about mv-reveal">
    {
      meta.length > 0 && (
        <p class="mv-about__meta">
          {meta.map((m, i) => (
            <>
              {i > 0 && (
                <span class="mv-about__meta-sep" aria-hidden="true">
                  {' '}
                  ·{' '}
                </span>
              )}
              <span>{m}</span>
            </>
          ))}
        </p>
      )
    }

    <div class="mv-about__teks">
      <p class="mv-about__lead">{lead}</p>
      <p class="mv-about__body">{lanjutan}</p>
    </div>

    <ul class="mv-about__nilai">
      {
        about.janjiNilai.map((n, i) => (
          <li class="mv-about__nilai-item">
            <span class="mv-about__nilai-nomor" aria-hidden="true">
              {nomor(i)}
            </span>
            <span class="mv-about__nilai-judul">{n.judul}</span>
            <span class="mv-about__nilai-desc">{n.deskripsi}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Container>

<style>
  .mv-about {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Byline identitas — kecil, huruf renggang, beraksen emas. */
  .mv-about__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-body-s);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .mv-about__meta-sep {
    color: var(--color-border-strong);
  }

  /* Kolom teks — lebar baca terkunci supaya paragraf tidak melebar
     jadi tembok teks di container besar. */
  .mv-about__teks {
    max-inline-size: 64ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mv-about__lead {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.1rem, 0.4vw + 0.95rem, 1.4rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .mv-about__body {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    text-wrap: pretty;
  }

  /* Strip janji nilai bernomor — lebar penuh, garis emas di atas. */
  .mv-about__nilai {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  .mv-about__nilai-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block-start: var(--space-3);
    border-block-start: 2px solid var(--color-accent);
  }

  .mv-about__nilai-nomor {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-body-s);
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-block-end: var(--space-1);
  }

  .mv-about__nilai-judul {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-body-m);
    line-height: 1.3;
    color: var(--color-text);
  }

  .mv-about__nilai-desc {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--color-text-2);
  }

  @media (max-width: 900px) {
    .mv-about__teks {
      max-inline-size: none;
    }

    .mv-about__nilai {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .mv-about__nilai {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
