---
/**
 * About — REDESIGN 2026-09-06 (permintaan klien): MINIMALIS &
 * VISUAL-DRIVEN.
 *
 * Dibuang total: headline "KONVEKSI CUSTOM APPAREL & RACEPACK" (sudah
 * ada di hero), eyebrow, dua paragraf panjang, dan baris fakta. Yang
 * tersisa: judul section bergaya sama dengan section lain, SATU foto
 * besar sebagai elemen utama, dan 4 janji nilai yang memang sudah
 * ringkas — cukup untuk "siapa MOTIVE" tanpa dinding teks.
 *
 * Semua konten dari `site.about` (guardrail 5). Fade-in: `.mv-reveal`.
 */
import { site } from '../../content/site';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { about } = site;
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading judul={about.judul} align="start" />

  <figure class="mv-about__media mv-reveal">
    <img
      src={about.foto.src}
      alt={about.foto.alt}
      width={about.foto.width}
      height={about.foto.height}
      loading="lazy"
      decoding="async"
    />
  </figure>

  <ul class="mv-about__nilai mv-reveal">
    {
      about.janjiNilai.map((n) => (
        <li class="mv-about__nilai-item">
          <span class="mv-about__nilai-judul">{n.judul}</span>
          <span class="mv-about__nilai-desc">{n.deskripsi}</span>
        </li>
      ))
    }
  </ul>
</Container>

<style>
  .mv-about__media {
    margin: 0;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .mv-about__media img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .mv-about__nilai {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .mv-about__nilai-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: 2px solid var(--color-accent);
  }

  .mv-about__nilai-judul {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-body-m);
    line-height: 1.3;
    color: var(--color-text);
  }

  .mv-about__nilai-desc {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--color-text-2);
  }

  @media (max-width: 900px) {
    .mv-about__nilai {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .mv-about__nilai {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
