---
/**
 * Gallery — REDESIGN 2026-08-30 (permintaan klien).
 *
 * Bento 9 sel dengan ukuran BEDA-BEDA (2 kotak besar, 1 lebar, sisanya
 * kecil) — bukan grid persegi seragam. Gambar di-SHUFFLE saat load dan
 * (bila pengguna tidak minta reduced-motion) berganti pelan tiap beberapa
 * detik — `src/scripts/gallery-shuffle.ts`.
 *
 * Daftar foto: `src/content/galeri.ts` (placeholder sampai foto hasil
 * produksi nyata dikirim). Tanpa JS: 9 sel tampil statis, tanpa shuffle.
 */
import { galeriFoto } from '../../content/galeri';
import { site } from '../../content/site';
import Container from '../layout/Container.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const AREA = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i'] as const;
const sel = AREA.map((area, i) => ({ area, foto: galeriFoto[i % galeriFoto.length]! }));

// Kolam foto untuk shuffle — diserahkan ke skrip lewat atribut data.
const pool = JSON.stringify(galeriFoto);
---

<Container as="section" spacing="section" id={id}>
  <header class="g__head">
    <h2 class="g__title">{site.galeri.judul}</h2>
  </header>

  <div class="g__grid" data-gallery data-gallery-pool={pool}>
    {
      sel.map(({ area, foto }) => (
        <figure class={`g__cell g__cell--${area}`} data-gallery-cell>
          <img
            src={foto.src}
            alt={foto.alt}
            width={foto.width}
            height={foto.height}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))
    }
  </div>
</Container>

<style>
  .g__head {
    margin-block-end: var(--space-7);
  }

  /* REDESIGN 2026-09-04 — gaya judul raksasa yang sama dengan "Our
     Services" & SectionHeading: emas, Space Grotesk 900, clamp besar. */
  .g__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-accent);
    font-size: clamp(2.75rem, 12vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin: 0;
    overflow-wrap: break-word;
    overflow: hidden;
  }

  .g__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(120px, 15vw, 200px);
    grid-template-areas:
      'a a b c'
      'a a d d'
      'e f f g'
      'h f f i';
    gap: var(--space-3);
  }

  .g__cell {
    margin: 0;
    overflow: hidden;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
  }

  .g__cell img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
    transition: opacity var(--dur-slow) var(--ease);
  }

  .g__cell--a {
    grid-area: a;
  }
  .g__cell--b {
    grid-area: b;
  }
  .g__cell--c {
    grid-area: c;
  }
  .g__cell--d {
    grid-area: d;
  }
  .g__cell--e {
    grid-area: e;
  }
  .g__cell--f {
    grid-area: f;
  }
  .g__cell--g {
    grid-area: g;
  }
  .g__cell--h {
    grid-area: h;
  }
  .g__cell--i {
    grid-area: i;
  }

  @media (max-width: 767.98px) {
    .g__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: none;
      grid-auto-rows: 42vw;
    }

    .g__cell {
      grid-area: auto !important;
    }
  }
</style>

<script>
  import { initGalleryShuffle } from '../../scripts/gallery-shuffle';
  initGalleryShuffle();
</script>
