---
/**
 * Gallery — REDESIGN 2026-09-06 (permintaan klien, referensi kolase
 * "Ring true to you").
 *
 * Bento grid lama DIGANTI KOLASE: 9 foto ditempatkan absolut di atas
 * panggung ber-aspect-ratio tetap, ukuran & rasio berbeda-beda, saling
 * TUMPANG TINDIH dan digeser naik-turun — bukan grid seragam.
 *
 * Interaksi:
 *   hover → foto naik + membesar halus dan maju ke depan (z-index)
 *   klik  → lightbox: foto melompat ke TENGAH layar & membesar
 *           (<dialog> + showModal), bisa digeser ke seluruh 26 foto
 *           lewat panah / keyboard.
 *
 * Rotasi otomatis (gallery-shuffle) DIBUANG — bertabrakan dengan hover
 * & klik: foto bisa berganti tepat saat kursor di atasnya.
 *
 * Di bawah 768px kolase runtuh jadi grid 2 kolom biasa — tumpang tindih
 * tidak terbaca di layar sempit.
 *
 * Foto: `src/content/galeri.ts` (sudah dikompres ke GALLERY-OPT).
 */
import { galeriFoto } from '../../content/galeri';
import { site } from '../../content/site';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

/* Sembilan slot kolase — koordinat dalam PERSEN terhadap panggung.
   Ditulis eksplisit (bukan dihitung) supaya komposisinya bisa ditata
   seperti kolase cetak: ada yang mepet tepi, ada yang menimpa. */
const SLOT = [
  { x: 2, y: 33, w: 15, ar: '3 / 4', z: 3 },
  { x: 13, y: 3, w: 15, ar: '3 / 4', z: 2 },
  { x: 26, y: 18, w: 24, ar: '4 / 3', z: 4 },
  { x: 47, y: 7, w: 18, ar: '3 / 4', z: 3 },
  { x: 68, y: 2, w: 17, ar: '1 / 1', z: 2 },
  { x: 72, y: 46, w: 20, ar: '4 / 3', z: 3 },
  { x: 37, y: 55, w: 17, ar: '1 / 1', z: 5 },
  { x: 6, y: 62, w: 14, ar: '3 / 4', z: 2 },
  { x: 86, y: 24, w: 12, ar: '3 / 4', z: 1 },
];

const sel = SLOT.map((s, i) => ({ s, foto: galeriFoto[i % galeriFoto.length]!, i }));
const semua = JSON.stringify(galeriFoto);
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading judul={site.galeri.judul} align="start" />

  <div class="g__stage" data-gallery data-gallery-pool={semua}>
    {
      sel.map(({ s, foto, i }) => (
        <button
          type="button"
          class="g__item"
          data-gallery-item={i}
          style={`--x:${s.x}%;--y:${s.y}%;--w:${s.w}%;--ar:${s.ar};--z:${s.z}`}
        >
          <img
            src={foto.src}
            alt={foto.alt}
            width={foto.width}
            height={foto.height}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))
    }
  </div>
</Container>

{
  /* Lightbox — di luar <Container> supaya tidak terpengaruh max-width
    section. <dialog> modal: focus trap, Esc, dan inert latar dari browser. */
}
<dialog class="g__box" aria-label="Pratinjau foto" data-gallery-box>
  <button type="button" class="g__box-tutup" data-gallery-close>
    <span class="sr-only">Tutup pratinjau</span>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <button type="button" class="g__box-nav g__box-nav--prev" data-gallery-prev>
    <span class="sr-only">Foto sebelumnya</span>
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>

  <figure class="g__box-figure">
    <img data-gallery-box-img src="" alt="" />
  </figure>

  <button type="button" class="g__box-nav g__box-nav--next" data-gallery-next>
    <span class="sr-only">Foto berikutnya</span>
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>
</dialog>

<style>
  /* ---------- panggung kolase ---------- */
  .g__stage {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 1360 / 780;
  }

  .g__item {
    -webkit-appearance: none;
    appearance: none;
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    inline-size: var(--w);
    aspect-ratio: var(--ar);
    z-index: var(--z);

    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 18px 46px -22px rgba(0, 0, 0, 0.85);
    transition:
      transform var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease);
  }

  .g__item img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .g__item:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  /* Hover: maju ke depan, naik sedikit, membesar halus. */
  @media (prefers-reduced-motion: no-preference) {
    .g__item:hover,
    .g__item:focus-visible {
      transform: translateY(-10px) scale(1.05);
      box-shadow: 0 30px 70px -24px rgba(0, 0, 0, 0.9);
      z-index: 20;
    }
  }

  /* ---------- lightbox ---------- */
  .g__box {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    max-inline-size: min(1100px, 92vw);
    max-block-size: 90vh;
    inline-size: min(1100px, 92vw);
    overflow: visible;
  }

  .g__box::backdrop {
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    /* Urutan sengaja: prefix dulu, standar terakhir (catatan minifier). */
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* "Melompat ke tengah & mendekat": skala naik dari 0,9 → 1 sambil
     memudar masuk. @starting-style + allow-discrete supaya <dialog>
     yang berpindah display/top-layer tetap bisa ditransisikan. */
  @media (prefers-reduced-motion: no-preference) {
    .g__box {
      opacity: 0;
      transform: scale(0.9);
      transition:
        opacity var(--dur-base) var(--ease),
        transform var(--dur-base) var(--ease),
        overlay var(--dur-base) var(--ease) allow-discrete,
        display var(--dur-base) var(--ease) allow-discrete;
    }

    .g__box[open] {
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      .g__box[open] {
        opacity: 0;
        transform: scale(0.9);
      }
    }
  }

  .g__box-figure {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .g__box-figure img {
    max-inline-size: 100%;
    max-block-size: 90vh;
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
    display: block;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9);
  }

  .g__box-tutup,
  .g__box-nav {
    -webkit-appearance: none;
    appearance: none;
    position: fixed;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 46px;
    block-size: 46px;
    padding: 0;
    background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    border: var(--border-width) solid var(--color-border);
    color: var(--color-text);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .g__box-tutup svg,
  .g__box-nav svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .g__box-tutup:hover,
  .g__box-nav:hover {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .g__box-tutup:focus-visible,
  .g__box-nav:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .g__box-tutup {
    inset-block-start: var(--space-5);
    inset-inline-end: var(--space-5);
  }

  .g__box-nav--prev {
    inset-inline-start: var(--space-4);
    inset-block-start: 50%;
    transform: translateY(-50%);
  }

  .g__box-nav--next {
    inset-inline-end: var(--space-4);
    inset-block-start: 50%;
    transform: translateY(-50%);
  }

  /* ---------- mobile: kolase runtuh jadi grid ---------- */
  @media (max-width: 767.98px) {
    .g__stage {
      aspect-ratio: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .g__item {
      position: static;
      inline-size: auto;
      aspect-ratio: 1 / 1;
      z-index: auto;
      box-shadow: none;
    }

    .g__box-nav {
      inline-size: 40px;
      block-size: 40px;
    }
  }
</style>

<script>
  import { initGalleryLightbox } from '../../scripts/gallery-lightbox';
  initGalleryLightbox();
</script>
