---
/**
 * Portofolio — REDESIGN 2026-09-06 (permintaan klien).
 *
 * SATU grid kartu logo berisi SELURUH klien — tidak dipisah per kategori,
 * tidak dipotong (sel "+ Banyak lagi" dibuang, semua ditampilkan).
 * Tema visual milik proyek: chip terang, sudut KOTAK, glow emas saat hover.
 *
 * Urutan kredibilitas tetap terjaga: `klien.ts` sudah berurut
 * Instansi/Pendidikan → Korporat → Event → Komunitas (AC T07.1).
 *
 * `ClientLogo` merender <img> untuk entri `izinTayang: true`, teks nama
 * untuk sisanya — wadah berukuran identik, grid tetap seragam.
 */
import { klien } from '../../content/klien';
import { site } from '../../content/site';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';
import ClientLogo from '../cards/ClientLogo.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { klienUi } = site;
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading judul={klienUi.judul} align="center" />

  <ul class="mv-klien__grid" role="list">
    {
      klien.map((k) => (
        <ClientLogo nama={k.nama} logo={k.logo} izinTayang={k.izinTayang} hero={k.tampilDiHero} />
      ))
    }
  </ul>
</Container>

<style>
  .mv-klien__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .mv-klien__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .mv-klien__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
