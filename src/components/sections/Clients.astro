---
/**
 * Our Clients — grid STATIS berkategori (S07, BLUEPRINT §8 Section 6).
 *
 * BUKAN marquee, BUKAN carousel, nol animasi, nol hover pada logo
 * (aturan rawan #1 & #2). Untuk audiens yang mengevaluasi risiko vendor,
 * membaca "Kementerian ESDM" dengan tenang > melihatnya lewat.
 *
 * Heading WAJIB "PERNAH DIPERCAYA OLEH" (dari `site.klienUi.judul`).
 * String "Klien Kami" / "Partner" / angka jumlah klien TIDAK ADA di
 * mana pun (AC T07.4). Disclaimer merek WAJIB di bawah grid (AC T07.4).
 *
 * Semua entri `klien.ts` sekarang `izinTayang: false` → `ClientLogo`
 * merender NAMA TEKS, nol `<img>` (AC T07.3). Mengubah satu entri ke
 * `true` (+ `logo`) langsung merender logonya — nol perubahan di sini.
 */
import type { KategoriKlien } from '../../content/types';
import { site } from '../../content/site';
import { klien } from '../../content/klien';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import ClientLogo from '../cards/ClientLogo.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { klienUi } = site;

/* Urutan kategori DIKUNCI — BLUEPRINT §5.2. Instansi & Pendidikan Tinggi
   PERTAMA (pengangkat kredibilitas tertinggi, AC T07.1). Union type tidak
   bisa di-iterate saat runtime, jadi urutannya jadi konstanta lokal. */
const KATEGORI_URUT: KategoriKlien[] = [
  'instansi-pendidikan',
  'korporat-properti',
  'event-olahraga',
  'komunitas-organisasi',
];

const kelompok = KATEGORI_URUT.map((kat) => ({
  kat,
  label: klienUi.labelKategori[kat],
  anggota: klien.filter((k) => k.kategori === kat),
})).filter((g) => g.anggota.length > 0);
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading nomor="06" judul={klienUi.judul} subjudul={klienUi.subjudul} />

  <div class="mv-klien">
    {
      kelompok.map((g) => (
        <div class="mv-klien__kategori">
          <h3 class="mv-klien__kategori-judul t-eyebrow">{g.label}</h3>
          <ul class="mv-klien__grid" role="list">
            {g.anggota.map((k) => (
              <ClientLogo
                nama={k.nama}
                logo={k.logo}
                izinTayang={k.izinTayang}
                hero={k.tampilDiHero}
              />
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <p class="mv-klien__disclaimer t-body-s">{klienUi.disclaimer}</p>

  <div class="mv-klien__cta">
    <WhatsAppButton konteks="kontak" label={klienUi.ctaLabel} variant="secondary" ikon={false} />
  </div>
</Container>

<style>
  .mv-klien {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .mv-klien__kategori {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mv-klien__kategori-judul {
    /* Eyebrow + garis aksen bawah — konsisten dengan bahasa visual proyek. */
    color: var(--color-text-2);
    margin: 0;
    padding-block-end: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .mv-klien__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 6 / 4 / 3 kolom (AC T07.1). Sel `1fr` — di 360px tidak overflow
       (tinggi sel tetap dikunci di ClientLogo, keseragaman ±0). */
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-3);
    justify-items: center;
  }

  .mv-klien__disclaimer {
    color: var(--color-text-2);
    margin: var(--space-6) 0 0;
    max-inline-size: 62ch;
  }

  .mv-klien__cta {
    margin-block-start: var(--space-6);
  }

  @media (max-width: 900px) {
    .mv-klien__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .mv-klien__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mv-klien {
      gap: var(--space-7);
    }
  }
</style>
