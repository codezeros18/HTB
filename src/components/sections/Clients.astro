---
/**
 * Portofolio — REDESIGN 2026-09-06 (permintaan klien, referensi dilampirkan).
 *
 * SATU grid kartu logo — TIDAK dipisah per kategori lagi (Instansi /
 * Korporat / Event / Komunitas). Layout mengikuti referensi (grid kartu
 * + sel "+ Banyak lagi"), tema visual tetap milik proyek: chip terang,
 * sudut KOTAK, glow emas saat hover.
 *
 * Urutan kredibilitas TETAP terjaga tanpa label kategori: `klien.ts`
 * sudah berurut Instansi/Pendidikan → Korporat → Event → Komunitas, jadi
 * `klien.slice(0, TAMPIL)` otomatis menaruh logo paling menaikkan
 * kredibilitas di baris atas (AC T07.1).
 *
 * `ClientLogo` merender <img> untuk entri `izinTayang: true`, teks nama
 * untuk sisanya — wadah berukuran identik, grid tetap seragam.
 */
import { site } from '../../content/site';
import { klien } from '../../content/klien';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';
import ClientLogo from '../cards/ClientLogo.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { klienUi } = site;

/* Tampilkan 14 teratas + sel "+ Banyak lagi" (referensi) = 3 baris penuh
   di grid 5 kolom. Sisanya tidak dirender — ini teaser, bukan daftar
   lengkap; nol angka jumlah klien di mana pun (AC T07.4). */
const TAMPIL = 14;
const tampil = klien.slice(0, TAMPIL);
const adaLagi = klien.length > TAMPIL;
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading judul={klienUi.judul} align="center" />

  <ul class="mv-klien__grid" role="list">
    {
      tampil.map((k) => (
        <ClientLogo nama={k.nama} logo={k.logo} izinTayang={k.izinTayang} hero={k.tampilDiHero} />
      ))
    }
    {adaLagi && <ClientLogo more={klienUi.labelLainnya} />}
  </ul>
</Container>

<style>
  .mv-klien__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .mv-klien__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .mv-klien__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
