---
/**
 * Services — REDESIGN 2026-08-30: kini KHUSUS "Bahan & Panduan Ukuran".
 *
 * Kenapa berubah: katalog produk sudah pindah ke <OurServices> (drill-down
 * dengan foto produk asli dari folder OUR SERVICE). Menampilkan grid produk
 * placeholder di sini jadi duplikat. Yang TIDAK ada di drill-down —
 * accordion bahan, panduan ukuran, dan tabel add-on — tetap tinggal di sini.
 *
 * Tab 3-level dilepas (tinggal satu topik), jadi struktur sekarang datar:
 *   accordion kelompok bahan → selector panduan ukuran → tabel add-on.
 *
 * Anchor `#bahan` dipertahankan untuk deep link lama.
 */
import { site } from '../../content/site';
import { bahan } from '../../content/bahan';
import { sizeCharts } from '../../content/size-charts';
import { harga } from '../../content/harga';
import type { TableRow } from '../ui/types';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';
import Accordion from '../ui/Accordion.astro';
import Table from '../ui/Table.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import MaterialCard from '../cards/MaterialCard.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

// Urutan kelompok = urutan kemunculan pertama di bahan.ts (PDF hlm. 8–12).
const kelompokBahan = [...new Set(bahan.map((b) => b.kelompok))];

// Add-on: 4 baris DTF + 1 baris paket lanyard = 5 baris nyata di harga.ts.
// Catatan A11/A17 SENGAJA tidak ikut — itu catatan internal tim (AC T05.6).
const barisAddOn: TableRow[] = [
  ...harga.sablonDTF.map((d) => ({
    header: d.nama,
    sel: [`Rp ${d.nominal.toLocaleString('id-ID')}`],
  })),
  {
    header: harga.paketLanyard.nama,
    sel: [`Rp ${harga.paketLanyard.nominal.toLocaleString('id-ID')}`],
  },
];
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading judul="Bahan & Panduan Ukuran" />

  {/* Anchor statis untuk deep link #bahan lama. */}
  <span id="bahan" class="sr-only"></span>

  <div class="mv-services__bahan">
    {
      kelompokBahan.map((k) => {
        const varian = bahan.filter((b) => b.kelompok === k);
        return (
          <Accordion judul={k} meta={`${varian.length} varian`} name="bahan-kelompok">
            <div class="mv-services__material-grid">
              {varian.map((v) => (
                <MaterialCard bahan={v} />
              ))}
            </div>
          </Accordion>
        );
      })
    }
  </div>

  <div class="mv-services__panduan">
    <h3 class="t-h3">{site.services.panduanUkuranJudul}</h3>

    <label class="mv-services__panduan-label t-body-s" for="pilih-ukuran">
      {site.services.panduanUkuranPilihLabel}
    </label>
    <select id="pilih-ukuran" class="mv-services__select" data-chart-select>
      {sizeCharts.map((c) => <option value={c.id}>{c.nama}</option>)}
    </select>

    {
      sizeCharts.map((c, i) => (
        <div
          class="mv-services__chart-panel"
          data-chart-panel
          data-chart-id={c.id}
          hidden={i !== 0}
        >
          {c.statusVerifikasi === 'terverifikasi' ? (
            <Table
              caption={`Panduan ukuran ${c.nama} (${c.unit})`}
              captionVisible
              kolom={['Ukuran', ...c.sizes]}
              baris={c.baris.map((b) => ({ header: b.label, sel: b.nilai }))}
              catatan={c.toleransi}
            />
          ) : (
            <div class="mv-services__chart-kosong">
              <p class="t-body-m">{site.services.panduanUkuranBelumVerifikasi}</p>
              <WhatsAppButton konteks="kontak" />
            </div>
          )}
        </div>
      ))
    }
  </div>

  <div class="mv-services__addon">
    <h3 class="t-h3">{site.services.addOnJudul}</h3>
    <Table
      caption="Harga sablon DTF dan paket lanyard"
      kolom={['Item', 'Harga']}
      baris={barisAddOn}
      align="end"
      sticky={false}
    />
  </div>
</Container>

<style>
  .mv-services__bahan {
    display: flex;
    flex-direction: column;
  }

  .mv-services__material-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .mv-services__material-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .mv-services__panduan,
  .mv-services__addon {
    margin-block-start: var(--space-7);
  }

  .mv-services__panduan h3,
  .mv-services__addon h3 {
    margin: 0 0 var(--space-4);
    color: var(--color-text);
  }

  .mv-services__panduan-label {
    display: block;
    color: var(--color-text-2);
    margin-block-end: var(--space-2);
  }

  /* <select> NATIVE — nol dropdown kustom. */
  .mv-services__select {
    display: block;
    inline-size: 100%;
    max-inline-size: 24rem;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-4);
    background-color: var(--color-bg);
    color: var(--color-text);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-control);
    font-size: var(--fs-body-m);
    margin-block-end: var(--space-5);
  }

  .mv-services__select:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .mv-services__chart-kosong {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-control);
  }

  .mv-services__chart-kosong p {
    color: var(--color-text-2);
    margin: 0;
    max-inline-size: 48ch;
  }
</style>

<script>
  import { initSizeChartSelector } from '../../scripts/tabs';
  initSizeChartSelector();
</script>
