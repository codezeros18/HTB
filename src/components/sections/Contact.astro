---
/**
 * Contact — REDESIGN 2026-09-05 (permintaan klien).
 *
 * Form 5-field + Web3Forms + honeypot DIHAPUS TOTAL: client semua closing
 * lewat WhatsApp, form tertulis tidak diperlukan. Section jadi HANYA judul
 * (raksasa, di tengah) + satu tombol WhatsApp di bawahnya — nol
 * kartu/kotak, nol grid 2 kolom. `src/scripts/contact-form.ts` dihapus
 * (satu-satunya pemakainya section ini).
 *
 * Section TERAKHIR sebelum Footer → `Container` memakai `last`.
 */
import { site } from '../../content/site';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { kontak } = site;
---

<Container as="section" spacing="section" id={id} last>
  <div class="mv-kontak mv-reveal">
    <SectionHeading judul={kontak.judul} align="center" />
    <WhatsAppButton konteks="kontak" size="lg" />
  </div>
</Container>

<style>
  .mv-kontak {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>
