---
/**
 * Contact — REDESIGN 2026-09-06 (permintaan klien).
 *
 * Form dihapus total (client semua closing lewat WhatsApp). Section jadi
 * SATU LAYAR PENUH (min 100vh) berisi judul raksasa "How Can We Help" +
 * satu tombol WhatsApp, dipusatkan vertikal & horizontal — penutup situs
 * yang tegas. Nol kartu/kotak.
 *
 * Section TERAKHIR sebelum Footer.
 */
import { site } from '../../content/site';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const { kontak } = site;
---

<Container as="section" id={id} class="mv-kontak">
  <div class="mv-kontak__inner mv-reveal">
    <SectionHeading judul={kontak.judul} align="center" />
    <WhatsAppButton konteks="kontak" size="lg" />
  </div>
</Container>

<style>
  .mv-kontak {
    /* Satu layar penuh — penutup situs. */
    min-block-size: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-8);
  }

  @media (max-width: 767.98px) {
    .mv-kontak {
      min-block-size: 100svh;
    }
  }

  .mv-kontak__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>
