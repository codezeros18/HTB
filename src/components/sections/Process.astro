---
/**
 * Proses Produksi — REDESIGN 2026-08-31 (permintaan klien: "boring, ga ada
 * meaning").
 *
 * Alur BOUSTROPHEDON (ular): 11 kartu kaca mengalir kiri→kanan, mentok
 * kanan lalu turun & balik kanan→kiri, dst. Konektor garis putus-putus +
 * chevron emas menyambungkan tiap tahap → jelas terbaca sebagai SATU alur:
 * bahan datang → pola → potong → jahit → QC → kirim.
 *
 * Nol JavaScript, nol sticky panel (dibuang — dulu bergantung media yang
 * tak pernah ada). Posisi grid tiap kartu dihitung di frontmatter dari
 * indeksnya; di bawah 1024px degradasi ke daftar vertikal biasa.
 *
 * Konten `deskripsi` tetap dari `proses.ts` apa adanya (guardrail 1).
 */
import { proses, babakProses } from '../../content/proses';
import Container from '../layout/Container.astro';
import SectionHeading from '../layout/SectionHeading.astro';

interface Props {
  id?: string;
}

const { id }: Props = Astro.props;

const COLS = 4;
const judulBabak = new Map<string, string>(babakProses.map((b) => [b.babak, b.judul]));
const nomorDua = (n: number): string => String(n).padStart(2, '0');

type Flow = 'right' | 'left' | 'down' | 'end';

const langkah = proses.map((t, i) => {
  const row = Math.floor(i / COLS);
  const posInRow = i % COLS;
  // Baris genap mengalir kiri→kanan, baris ganjil kanan→kiri.
  const visualCol = row % 2 === 0 ? posInRow : COLS - 1 - posInRow;
  const nextRow = Math.floor((i + 1) / COLS);

  let flow: Flow;
  if (i === proses.length - 1) flow = 'end';
  else if (nextRow !== row) flow = 'down';
  else flow = row % 2 === 0 ? 'right' : 'left';

  return { t, gridCol: visualCol + 1, gridRow: row + 1, flow };
});
---

<Container as="section" spacing="section" id={id}>
  <SectionHeading nomor="05" judul="Proses Produksi 11 Tahap" />

  <ol class="mv-flow" aria-label="Sebelas tahap produksi, berurutan">
    {
      langkah.map(({ t, gridCol, gridRow, flow }) => (
        <li class="mv-proses__step" data-flow={flow} style={`--vcol:${gridCol};--vrow:${gridRow}`}>
          <span class="mv-proses__step-babak t-eyebrow">
            <span class="sr-only">Babak {t.babak}: </span>
            {judulBabak.get(t.babak)}
          </span>
          <span class="mv-proses__step-num" aria-hidden="true">
            {nomorDua(t.nomor)}
          </span>
          <h3 class="mv-proses__step-nama t-h3">{t.nama}</h3>
          {t.deskripsi && <p class="mv-proses__step-desc t-body-s">{t.deskripsi}</p>}
          {flow !== 'end' && <span class="mv-proses__flow" aria-hidden="true" />}
        </li>
      ))
    }
  </ol>
</Container>

<style>
  .mv-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--flow-gap, var(--space-6));
    --flow-gap: var(--space-6);
  }

  .mv-proses__step {
    position: relative;
    grid-column: var(--vcol);
    grid-row: var(--vrow);

    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);

    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
    /* blur + elevasi kaca dari pass universal di global.css */
  }

  .mv-proses__step-babak {
    color: var(--color-text-2);
  }

  .mv-proses__step-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .mv-proses__step-nama {
    color: var(--color-text);
    margin: 0;
  }

  .mv-proses__step-desc {
    color: var(--color-text-2);
    margin: 0;
  }

  /* ---------- konektor alur ---------- */
  .mv-proses__flow {
    position: absolute;
    z-index: 1;
    --flow-col: color-mix(in srgb, var(--color-accent) 60%, transparent);
  }

  /* garis putus-putus horizontal (kanan / kiri) */
  .mv-proses__step[data-flow='right'] .mv-proses__flow,
  .mv-proses__step[data-flow='left'] .mv-proses__flow {
    inset-block-start: 50%;
    inline-size: var(--flow-gap);
    block-size: 0;
    border-block-start: 2px dashed var(--flow-col);
  }
  .mv-proses__step[data-flow='right'] .mv-proses__flow {
    inset-inline-end: calc(-1 * var(--flow-gap));
  }
  .mv-proses__step[data-flow='left'] .mv-proses__flow {
    inset-inline-start: calc(-1 * var(--flow-gap));
  }

  /* garis vertikal (turun ke baris berikutnya) */
  .mv-proses__step[data-flow='down'] .mv-proses__flow {
    inset-inline-start: 50%;
    inset-block-end: calc(-1 * var(--flow-gap));
    inline-size: 0;
    block-size: var(--flow-gap);
    border-inline-start: 2px dashed var(--flow-col);
  }

  /* chevron emas di ujung konektor */
  .mv-proses__flow::after {
    content: '';
    position: absolute;
    inline-size: 0;
    block-size: 0;
    border: 5px solid transparent;
  }
  .mv-proses__step[data-flow='right'] .mv-proses__flow::after {
    inset-inline-end: -3px;
    inset-block-start: -6px;
    border-inline-start-color: var(--color-accent);
  }
  .mv-proses__step[data-flow='left'] .mv-proses__flow::after {
    inset-inline-start: -3px;
    inset-block-start: -6px;
    border-inline-end-color: var(--color-accent);
  }
  .mv-proses__step[data-flow='down'] .mv-proses__flow::after {
    inset-block-end: -3px;
    inset-inline-start: -6px;
    border-block-start-color: var(--color-accent);
  }

  /* ---------- tablet: 2 kolom, alur vertikal biasa ---------- */
  @media (max-width: 1023.98px) {
    .mv-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mv-proses__step {
      grid-column: auto !important;
      grid-row: auto !important;
    }
    /* semua konektor jadi "turun" */
    .mv-proses__step .mv-proses__flow {
      inset-block: auto;
      inset-inline: auto;
      inset-inline-start: 50%;
      inset-block-end: calc(-1 * var(--flow-gap));
      inline-size: 0;
      block-size: var(--flow-gap);
      border-block-start: 0;
      border-inline-start: 2px dashed var(--flow-col);
    }
    .mv-proses__step .mv-proses__flow::after {
      inset: auto;
      inset-block-end: -3px;
      inset-inline-start: -6px;
      border-color: transparent;
      border-block-start-color: var(--color-accent);
    }
  }

  @media (max-width: 639.98px) {
    .mv-flow {
      grid-template-columns: 1fr;
    }
  }
</style>
