---
/**
 * Footer — REDESIGN 2026-09-06 (permintaan klien: "polish").
 *
 * Dua blok: KIRI merek + tagline + CTA WhatsApp; KANAN kolom tautan
 * (Navigasi, Kontak, dan Sosial Media bila ada). Judul kolom = eyebrow
 * emas. Baris bawah: copyright + (NIB bila ada) + "Kembali ke atas".
 *
 * Kolom 4 (sosial media) HILANG SELURUHNYA saat `site.sosmed === null`.
 * NIB di baris bawah juga hanya muncul bila terisi (guardrail 1).
 *
 * Mobile: kolom tautan jadi <details> tertutup supaya footer ringkas.
 * Tanpa JS tetap bisa dibuka manual (<details> native). Tahun copyright
 * dihitung saat build.
 */
import { site } from '../../content/site';
import { lokasi } from '../../content/lokasi';
import { navItems } from './nav-items';
import WhatsAppButton from '../ui/WhatsAppButton.astro';

const tahun = new Date().getFullYear();
const headOffice = lokasi.find((l) => l.slug === 'head-office') ?? lokasi[0];
const waTampil = site.whatsapp.replace(/^62/, '0');
---

<footer class="mv-footer">
  <div class="mv-footer__inner">
    <div class="mv-footer__brand">
      <img
        class="mv-footer__merek"
        src="/images/logo/LOGO%20MOTIVE%20NEW%20PUTIH.png"
        alt={site.brand}
        width="1721"
        height="223"
        loading="lazy"
      />
      <p class="mv-footer__official t-body-s">Official brand by {site.namaCV}</p>
      <p class="mv-footer__tagline t-body-s">{site.tagline}</p>
      <div class="mv-footer__cta">
        <WhatsAppButton konteks="footer" />
      </div>
    </div>

    <nav class="mv-footer__nav" aria-label="Navigasi footer">
      <details class="mv-footer__detail" open>
        <summary class="mv-footer__judul t-eyebrow">Navigasi</summary>
        <ul class="mv-footer__list">
          {
            navItems.map((item) => (
              <li>
                <a class="mv-footer__link t-body-s" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <details class="mv-footer__detail" open>
        <summary class="mv-footer__judul t-eyebrow">Kontak</summary>
        <ul class="mv-footer__list">
          <li>
            <a class="mv-footer__link t-body-s" href={`https://wa.me/${site.whatsapp}`}>
              WhatsApp {waTampil}
            </a>
          </li>
          <li>
            <a class="mv-footer__link t-body-s" href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          {
            headOffice && (
              <li>
                <address class="mv-footer__alamat t-body-s">
                  <span class="mv-footer__peran">{headOffice.peran}</span>
                  {headOffice.alamat}
                </address>
              </li>
            )
          }
        </ul>
      </details>

      {
        site.sosmed && site.sosmed.length > 0 && (
          <details class="mv-footer__detail" open>
            <summary class="mv-footer__judul t-eyebrow">Sosial Media</summary>
            <ul class="mv-footer__list">
              {site.sosmed.map((s) => (
                <li>
                  <a
                    class="mv-footer__link t-body-s"
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </nav>
  </div>

  <div class="mv-footer__bawah">
    <p class="t-body-s">{`© ${tahun} ${site.namaCV}. Seluruh hak cipta dilindungi.`}</p>
    {site.nib && <p class="t-body-s">NIB: {site.nib}</p>}
    <a class="mv-footer__totop t-body-s" href="#top">Kembali ke atas &uarr;</a>
  </div>
</footer>

<style>
  .mv-footer {
    background-color: var(--color-surface);
    border-block-start: var(--border-width) solid var(--color-border);
    padding-block: var(--space-8);
    padding-inline: var(--edge-pad);
  }

  .mv-footer__inner,
  .mv-footer__bawah {
    max-inline-size: var(--container-max);
    margin-inline: auto;
  }

  .mv-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 2fr);
    gap: var(--space-8);
    align-items: start;
  }

  /* ---------- kiri: merek ---------- */
  .mv-footer__merek {
    display: block;
    inline-size: auto;
    block-size: auto;
    max-block-size: 30px;
    max-inline-size: 210px;
    object-fit: contain;
  }

  .mv-footer__official,
  .mv-footer__tagline {
    color: var(--color-text-2);
    margin-block: var(--space-2) 0;
    max-inline-size: 42ch;
  }

  .mv-footer__cta {
    margin-block-start: var(--space-5);
  }

  /* ---------- kanan: kolom tautan ---------- */
  .mv-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-6);
  }

  .mv-footer__judul {
    color: var(--color-accent);
    list-style: none;
    cursor: default;
    padding-block: var(--space-2);
  }

  .mv-footer__judul::-webkit-details-marker {
    display: none;
  }

  .mv-footer__judul::marker {
    content: '';
  }

  .mv-footer__judul:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .mv-footer__list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mv-footer__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    color: var(--color-text-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .mv-footer__link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .mv-footer__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .mv-footer__alamat {
    font-style: normal;
    color: var(--color-text-2);
    padding-block: var(--space-2);
    max-inline-size: 30ch;
  }

  .mv-footer__peran {
    display: block;
    color: var(--color-text);
    font-weight: 700;
  }

  /* ---------- baris bawah ---------- */
  .mv-footer__bawah {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-text-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .mv-footer__bawah p {
    margin: 0;
  }

  .mv-footer__totop {
    margin-inline-start: auto;
    color: var(--color-text-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .mv-footer__totop:hover {
    color: var(--color-accent);
  }

  .mv-footer__totop:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  /* ---------- desktop: <details> selalu terbuka ---------- */
  @media (min-width: 768px) {
    .mv-footer__detail > .mv-footer__list {
      display: flex !important;
    }
  }

  /* ---------- mobile ---------- */
  @media (max-width: 767.98px) {
    .mv-footer {
      padding-block: var(--space-7);
    }

    .mv-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .mv-footer__nav {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .mv-footer__detail {
      border-block-start: var(--border-width) solid var(--color-border);
    }

    .mv-footer__judul {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-block-size: var(--tap-min);
      cursor: pointer;
    }

    /* Penanda buka/tutup — hanya transform (§6.7). */
    .mv-footer__judul::after {
      content: '';
      inline-size: 8px;
      block-size: 8px;
      border-inline-end: 2px solid currentColor;
      border-block-end: 2px solid currentColor;
      transform: rotate(45deg) translate(-2px, -2px);
      transition: transform var(--dur-base) var(--ease);
    }

    .mv-footer__detail[open] .mv-footer__judul::after {
      transform: rotate(-135deg) translate(-2px, -2px);
    }

    /* Tagline dibuang di mobile: sudah tampil di meta description. */
    .mv-footer__tagline {
      display: none;
    }

    .mv-footer__bawah {
      margin-block-start: var(--space-5);
      padding-block-start: var(--space-4);
    }

    .mv-footer__totop {
      margin-inline-start: 0;
      inline-size: 100%;
      padding-block: var(--space-2);
    }
  }
</style>

<script>
  /* Desktop: <details> selalu terbuka; mobile: tertutup. `open` tak bisa
     diatur media query, jadi disinkronkan di sini. Tanpa JS: kolom tetap
     bisa dibuka manual (<details> native, dirender `open`). */
  const mq = window.matchMedia('(min-width: 768px)');
  const kolom = document.querySelectorAll<HTMLDetailsElement>('.mv-footer__detail');

  const sync = (desktop: boolean): void => {
    kolom.forEach((d) => {
      d.open = desktop;
      const s = d.querySelector('summary');
      if (s) {
        if (desktop) s.setAttribute('tabindex', '-1');
        else s.removeAttribute('tabindex');
      }
    });
  };

  sync(mq.matches);
  mq.addEventListener('change', (e) => sync(e.matches));
</script>
