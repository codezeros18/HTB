---
/**
 * Navbar — REDESIGN 2026-09-06 (permintaan klien, referensi bisasinema.id).
 *
 * SISTEM BARU: bar transparan tipis berisi TIGA hal saja —
 *   kiri   : tombol hamburger + label "Menu" → membuka sidebar kiri
 *   tengah : logo MOTIVE, TIDAK tampil selagi hero terlihat; memudar
 *            masuk begitu hero tergeser lewat (`data-logo-hidden`)
 *   kanan  : tautan "Let's Talk" (WhatsApp) dengan underline saat hover
 *
 * Daftar navigasi + mega menu DIPINDAH ke sidebar (`MobileMenu.astro`,
 * kini dipakai di SEMUA lebar layar, bukan cuma mobile).
 *
 * ── KENAPA CLS = 0 ─────────────────────────────────────────────
 *   .mv-nav          fixed, block-size --nav-h — KONSTAN selamanya
 *   .mv-nav__surface absolute, hanya warna/blur yang berubah
 *   .mv-nav-spacer   block-size 0 — navbar menumpang di atas hero
 * Nol properti layout yang dianimasikan; hanya opacity/visibility.
 *
 * ── NOL scroll listener ────────────────────────────────────────
 * "Sudah discroll" (permukaan jadi kaca) = sentinel 120px + observer
 * bersama S02. "Logo boleh tampil" = observer pada `.mv-hero`.
 *
 * Props:
 *   heroNav  homepage — logo mulai tersembunyi, muncul setelah hero.
 */
import { site, waLink } from '../../content/site';

interface Props {
  heroNav?: boolean;
}

const { heroNav = false }: Props = Astro.props;
---

<header
  class="mv-nav"
  data-mv-nav
  data-logo-hidden={heroNav ? '' : undefined}
  data-mv-logo-herohide={heroNav ? '' : undefined}
>
  <div class="mv-nav__surface">
    <div class="mv-nav__inner">
      <button
        type="button"
        class="mv-nav__menu"
        data-mv-menu-open
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <span class="mv-nav__bars" aria-hidden="true"></span>
        <span class="mv-nav__menu-label">Menu</span>
      </button>

      <a class="mv-nav__logo" href="/#top" aria-label={`${site.brand} — kembali ke atas`}>
        <img
          class="mv-nav__logo-img"
          src="/images/logo/LOGO%20MOTIVE%20NEW%20PUTIH.png"
          alt={site.brand}
          width="1721"
          height="223"
        />
      </a>

      <a class="mv-nav__cta" href={waLink('navbar')} target="_blank" rel="noopener noreferrer">
        <span class="mv-nav__ctalabel">Let's Talk</span>
      </a>
    </div>
  </div>
</header>

{
  /* Penahan tinggi di alur dokumen (0px — navbar menumpang di atas hero).
    Sentinel 120px menumpang di sini untuk mendeteksi "sudah discroll"
    tanpa scroll listener. */
}
<div class="mv-nav-spacer" aria-hidden="true">
  <span class="mv-nav__sentinel" data-mv-nav-sentinel></span>
</div>

{
  /* JS mati → observer hero tak pernah jalan → logo macet tersembunyi
    di homepage. Kembalikan visibilitasnya. */
}
<noscript>
  <style>
    .mv-nav[data-logo-hidden] .mv-nav__logo {
      opacity: 1;
      visibility: visible;
    }
  </style>
</noscript>

<style>
  .mv-nav,
  .mv-nav-spacer {
    --nav-h: 60px;
  }

  /* ---------- kerangka ---------- */
  .mv-nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    block-size: var(--nav-h); /* KONSTAN — jangan pernah dianimasikan */
    pointer-events: none;
  }

  .mv-nav-spacer {
    position: relative;
    block-size: 0;
  }

  .mv-nav__sentinel {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 1px;
    block-size: 120px;
    pointer-events: none;
  }

  /* ---------- permukaan ---------- */
  .mv-nav__surface {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: var(--nav-h);
    pointer-events: auto;

    background-color: transparent;
    border-block-end: var(--border-width) solid transparent;

    transition:
      background-color var(--dur-base) var(--ease),
      backdrop-filter var(--dur-base) var(--ease),
      border-block-end-color var(--dur-base) var(--ease);
  }

  .mv-nav[data-scrolled] .mv-nav__surface {
    background-color: color-mix(in srgb, var(--color-bg) 72%, transparent);
    /* Urutan SENGAJA: prefix dulu, standar terakhir — minifier CSS
       mem-fold pasangan bernilai identik dan yang selamat adalah yang
       ditulis PALING BELAKANG. */
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-block-end-color: color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  /* ---------- isi: kiri · tengah · kanan ---------- */
  .mv-nav__inner {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: var(--nav-h);

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);

    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--edge-pad);
  }

  /* ---------- kiri: hamburger + label ---------- */
  .mv-nav__menu {
    -webkit-appearance: none;
    appearance: none;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--tap-min);
    padding: 0;
    background: transparent;
    border: 0;
    color: #ffffff;
    cursor: pointer;
  }

  .mv-nav__menu-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mv-nav__menu:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .mv-nav__bars,
  .mv-nav__bars::before,
  .mv-nav__bars::after {
    display: block;
    inline-size: 22px;
    block-size: 2px;
    background-color: currentColor;
  }

  .mv-nav__bars {
    position: relative;
  }

  .mv-nav__bars::before,
  .mv-nav__bars::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .mv-nav__bars::before {
    inset-block-start: -7px;
  }

  .mv-nav__bars::after {
    inset-block-start: 7px;
  }

  /* ---------- tengah: logo (sembunyi selagi hero) ---------- */
  .mv-nav__logo {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    text-decoration: none;
    transition: opacity var(--dur-base) var(--ease);
  }

  .mv-nav[data-logo-hidden] .mv-nav__logo {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .mv-nav__logo:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .mv-nav__logo-img {
    display: block;
    inline-size: auto;
    block-size: auto;
    max-block-size: 26px;
    max-inline-size: 190px;
    object-fit: contain;
  }

  /* ---------- kanan: Let's Talk ---------- */
  .mv-nav__cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    line-height: normal;
  }

  .mv-nav__cta:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  /* Underline animasi saat hover. */
  .mv-nav__ctalabel {
    position: relative;
    display: inline-block;
    padding-block: var(--space-1);
  }

  .mv-nav__ctalabel::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 2px;
    background-color: #ffffff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-fast) var(--ease);
  }

  .mv-nav__cta:hover .mv-nav__ctalabel::after {
    transform: scaleX(1);
  }

  /* ---------- responsif ---------- */
  @media (max-width: 767.98px) {
    .mv-nav__logo-img {
      max-block-size: 22px;
      max-inline-size: 150px;
    }
  }

  @media (max-width: 639.98px) {
    /* Label "Menu" dibuang — ikon hamburger sudah cukup, dan ruang
       dibutuhkan logo + CTA. */
    .mv-nav__menu-label {
      display: none;
    }

    .mv-nav__cta {
      font-size: 14px;
    }
  }
</style>

<script>
  import { observeElement } from '../../scripts/observer';
  import { navItems } from './nav-items';

  const nav = document.querySelector<HTMLElement>('[data-mv-nav]');
  const sentinel = document.querySelector<HTMLElement>('[data-mv-nav-sentinel]');

  /* --- permukaan kaca saat sudah discroll: sentinel 120px --- */
  if (nav && sentinel) {
    observeElement(
      sentinel,
      (entry) => {
        if (entry.isIntersecting) nav.removeAttribute('data-scrolled');
        else nav.setAttribute('data-scrolled', '');
      },
      { threshold: 0, rootMargin: '0px', once: false }
    );
  }

  /* --- homepage: logo tengah baru muncul setelah hero tergeser lewat ---
     `data-logo-hidden` sudah ada di markup (nol flash). Tanpa
     IntersectionObserver (browser lawas) → langsung tampilkan. */
  if (nav?.hasAttribute('data-mv-logo-herohide')) {
    const hero = document.querySelector<HTMLElement>('.mv-hero');
    if (hero && typeof IntersectionObserver === 'function') {
      observeElement(
        hero,
        (entry) => {
          nav.toggleAttribute('data-logo-hidden', entry.isIntersecting);
        },
        { threshold: 0, rootMargin: '0px', once: false }
      );
    } else {
      nav.removeAttribute('data-logo-hidden');
    }
  }

  /* --- penanda section aktif untuk tautan di sidebar --- */
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
    const id = a.dataset.navLink;
    if (id) links.set(id, a);
  });

  const terlihat = new Set<string>();
  const urutan = navItems.map((i) => i.sectionId);

  const perbarui = (): void => {
    const aktif = urutan.find((id) => terlihat.has(id)) ?? null;
    for (const [id, a] of links) {
      if (id === aktif) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
  };

  for (const id of urutan) {
    const section = document.getElementById(id);
    if (!section) continue;
    observeElement(
      section,
      (entry) => {
        if (entry.isIntersecting) terlihat.add(id);
        else terlihat.delete(id);
        perbarui();
      },
      { threshold: 0.35, rootMargin: '0px', once: false }
    );
  }
</script>
