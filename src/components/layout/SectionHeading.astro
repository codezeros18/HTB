---
/**
 * SectionHeading — REDESIGN 2026-09-04 (permintaan klien).
 *
 * Judul section raksasa bergaya sama dengan "Our Services": --font-display
 * (Poppins) weight 800, UPPERCASE, warna emas (`--color-accent`),
 * `clamp(2.25rem, 9.5vw, 7rem)`. Nomor "01".."10" + garis 56×2px versi lama
 * DIBUANG total.
 *
 * Posisi horizontal berbeda-beda per section (permintaan klien):
 *   start  kiri (default)   · center  tengah   · end  kanan
 *
 * Props:
 *   judul     teks heading. Uppercase lewat CSS, bukan data — nilai asli
 *             tetap terbaca screen reader (§6.5).
 *   subjudul  opsional. `null` → paragrafnya TIDAK dirender (guardrail 1).
 *   id        dipasang ke heading; untuk `aria-labelledby` di section.
 *   as        tingkat heading. Default 'h2'.
 *   align     'start' (default) | 'center' | 'end'.
 */
interface Props {
  judul: string;
  subjudul?: string | null;
  id?: string;
  as?: 'h2' | 'h3';
  align?: 'start' | 'center' | 'end';
  class?: string;
}

const {
  judul,
  subjudul = null,
  id,
  as: Heading = 'h2',
  align = 'start',
  class: className,
}: Props = Astro.props;
---

<header class:list={['mv-heading', `mv-heading--${align}`, className]}>
  <Heading id={id} class="mv-heading__judul">{judul}</Heading>
  {subjudul && <p class="mv-heading__sub t-body-l">{subjudul}</p>}
</header>

<style>
  .mv-heading {
    display: flex;
    flex-direction: column;
    /* Jarak heading → konten section dikunci di sini. */
    margin-block-end: var(--space-7); /* 48px */
  }

  .mv-heading--center {
    align-items: center;
    text-align: center;
  }

  .mv-heading--end {
    align-items: flex-end;
    text-align: right;
  }

  .mv-heading__judul {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-accent);
    font-size: clamp(2.25rem, 9.5vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin: 0;
    /* Kata tunggal super-panjang (mis. "KONSULTASIKAN") boleh patah
       daripada memaksa halaman melebar di 360px. */
    overflow-wrap: break-word;
    overflow: hidden;
  }

  .mv-heading__sub {
    color: var(--color-text-2);
    margin-block-start: var(--space-4); /* 16px */
    max-inline-size: 62ch;
  }

  .mv-heading--center .mv-heading__sub {
    margin-inline: auto;
  }

  .mv-heading--end .mv-heading__sub {
    margin-inline-start: auto;
  }

  @media (max-width: 767.98px) {
    .mv-heading {
      margin-block-end: var(--space-6); /* 32px */
    }
  }
</style>
