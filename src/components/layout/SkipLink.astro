---
/**
 * SkipLink — elemen fokus PERTAMA di halaman (§7.8).
 *
 * Tersembunyi secara visual sampai difokus, lalu muncul di kiri atas
 * di atas navbar. Bukan `display: none` — itu akan menghapusnya dari
 * urutan Tab dan membuatnya sia-sia.
 *
 * Props:
 *   target  id tujuan tanpa '#'. Default 'konten-utama'.
 *   label   teks tautan. Default 'Lompat ke konten utama'.
 */
interface Props {
  target?: string;
  label?: string;
}

const { target = 'konten-utama', label = 'Lompat ke konten utama' }: Props = Astro.props;
---

<a class="mv-skip t-label" href={`#${target}`}>{label}</a>

<style>
  .mv-skip {
    position: fixed;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    /* Di atas navbar (--z-nav) supaya tetap terlihat saat difokus. */
    z-index: 100;

    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-4);

    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-control);
    text-decoration: none;

    /* Disembunyikan dengan transform, bukan display:none — tetap
       fokusabel dan tetap ada di urutan Tab. */
    transform: translateY(calc(-100% - var(--space-4)));
    transition: transform var(--dur-base) var(--ease);
  }

  /* `:focus` DAN `:focus-visible`. Skip link hanya bisa dicapai lewat
     keyboard, jadi setiap fokus wajib memunculkannya — jangan bergantung
     pada heuristik :focus-visible saja. */
  .mv-skip:focus,
  .mv-skip:focus-visible {
    transform: translateY(0);
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }
</style>
