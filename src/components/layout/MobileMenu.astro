---
/**
 * Sidebar navigasi — REDESIGN 2026-09-06 (permintaan klien, referensi
 * bisasinema.id). Dulu panel full-screen KHUSUS mobile; sekarang DRAWER
 * KIRI yang dipakai di SEMUA lebar layar — seluruh daftar navigasi
 * pindah ke sini dari navbar.
 *
 * (Nama berkas & `id="menu-mobile"` sengaja dipertahankan: dipakai
 * BaseLayout + skrip verifikasi S03.)
 *
 * Isi: tombol Close · daftar nav besar (aktif = emas) · pintasan
 * layanan · tombol WhatsApp.
 *
 * Memakai <dialog> + showModal(): focus trap, Esc, dan inert latar
 * ditangani browser. Animasi masuk/keluar (geser dari kiri + backdrop
 * memudar) memakai @starting-style + transition-behavior: allow-discrete;
 * browser tanpa dukungan itu tetap membuka/menutup, hanya tanpa animasi.
 *
 * Yang ditangani JS: kunci scroll <body> (+ kompensasi scrollbar,
 * anti-CLS), sinkron `aria-expanded`, kembalikan fokus ke pemicu,
 * dan tutup panel saat item nav diklik.
 *
 * Dipicu dari Navbar: <button data-mv-menu-open aria-controls="menu-mobile">
 */
import { navItems } from './nav-items';
import { layanan, layananHref } from '../../content/layanan';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
---

<dialog id="menu-mobile" class="mv-menu" aria-label="Menu navigasi" data-mv-menu>
  <div class="mv-menu__panel">
    <button type="button" class="mv-menu__tutup" data-mv-menu-close>
      {/* Ikon X bergaya Lucide (ISC), inline — sepadan dengan ikon menu di navbar. */}
      <svg
        class="mv-menu__ikon"
        viewBox="0 0 24 24"
        width="22"
        height="22"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
      <span class="mv-menu__tutup-label">Close</span>
    </button>

    <nav class="mv-menu__nav" aria-label="Navigasi utama">
      <ul class="mv-menu__list">
        {
          navItems.map((item) => (
            <li>
              <a
                class="mv-menu__link"
                href={item.href}
                data-nav-link={item.sectionId}
                data-mv-menu-nav
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mv-menu__layanan">
      <p class="mv-menu__judul t-eyebrow">Layanan</p>
      <ul class="mv-menu__sublist">
        {
          layanan.map((l) => (
            <li>
              <a class="mv-menu__sublink" href={layananHref(l)} data-mv-menu-nav>
                {l.nama}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mv-menu__kaki">
      <WhatsAppButton konteks="navbar" fullWidth />
    </div>
  </div>
</dialog>

<style>
  /* Drawer KIRI: menempel tepi kiri, setinggi layar. <dialog> bawaan
     dipusatkan lewat `margin: auto` — dinolkan di sini. */
  .mv-menu {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    inset-inline-end: auto;
    margin: 0;
    padding: 0;
    border: 0;
    border-inline-end: var(--border-width) solid var(--color-border);

    inline-size: min(420px, 86vw);
    max-inline-size: none;
    block-size: 100%;
    max-block-size: 100%;

    background-color: var(--color-bg);
    color: var(--color-text);
    overflow-y: auto;

    /* Scrollbar kustom — tipis & tenang, bukan bawaan Chrome yang tebal
       dan abu-abu terang (mencolok di panel gelap). Firefox pakai
       `scrollbar-width/color`; Chromium/Safari pakai ::-webkit-scrollbar
       di bawah. Thumb pil: pengecualian sengaja dari aturan "nol rounded"
       — ini chrome UI selebar 6px, bukan kartu/panel. */
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-text) 22%, transparent) transparent;
  }

  .mv-menu::-webkit-scrollbar {
    inline-size: 6px;
  }

  .mv-menu::-webkit-scrollbar-track {
    background: transparent;
  }

  .mv-menu::-webkit-scrollbar-thumb {
    background-color: color-mix(in srgb, var(--color-text) 22%, transparent);
    border-radius: 999px;
  }

  .mv-menu::-webkit-scrollbar-thumb:hover {
    background-color: color-mix(in srgb, var(--color-accent) 65%, transparent);
  }

  .mv-menu::backdrop {
    background-color: var(--modal-backdrop);
  }

  /* Animasi geser-dari-kiri + backdrop memudar. `allow-discrete` +
     @starting-style membuat <dialog> (yang berpindah display/top-layer)
     tetap bisa ditransisikan. Tanpa dukungan → buka/tutup instan. */
  @media (prefers-reduced-motion: no-preference) {
    .mv-menu {
      transform: translateX(-100%);
      transition:
        transform var(--dur-slow) var(--ease),
        overlay var(--dur-slow) var(--ease) allow-discrete,
        display var(--dur-slow) var(--ease) allow-discrete;
    }

    .mv-menu[open] {
      transform: translateX(0);
    }

    @starting-style {
      .mv-menu[open] {
        transform: translateX(-100%);
      }
    }

    .mv-menu::backdrop {
      opacity: 0;
      transition:
        opacity var(--dur-slow) var(--ease),
        overlay var(--dur-slow) var(--ease) allow-discrete,
        display var(--dur-slow) var(--ease) allow-discrete;
    }

    .mv-menu[open]::backdrop {
      opacity: 1;
    }

    @starting-style {
      .mv-menu[open]::backdrop {
        opacity: 0;
      }
    }
  }

  .mv-menu__panel {
    display: flex;
    flex-direction: column;
    min-block-size: 100%;
    padding: var(--space-5) var(--space-6) var(--space-6);
    gap: var(--space-6);
  }

  /* ---------- Close ---------- */
  .mv-menu__tutup {
    -webkit-appearance: none;
    appearance: none;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--tap-min);
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--color-text);
    cursor: pointer;
    flex: 0 0 auto;
  }

  .mv-menu__ikon {
    display: block;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .mv-menu__tutup-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mv-menu__tutup:focus-visible,
  .mv-menu__link:focus-visible,
  .mv-menu__sublink:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  /* ---------- daftar nav besar ---------- */
  .mv-menu__nav {
    flex: 0 0 auto;
  }

  .mv-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mv-menu__link {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .mv-menu__link:hover,
  .mv-menu__link[aria-current='true'] {
    color: var(--color-accent);
  }

  /* ---------- pintasan layanan ---------- */
  .mv-menu__layanan {
    flex: 1 1 auto;
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .mv-menu__judul {
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }

  .mv-menu__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mv-menu__sublink {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    font-size: var(--fs-body-m);
    color: var(--color-text-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .mv-menu__sublink:hover {
    color: var(--color-text);
  }

  .mv-menu__kaki {
    flex: 0 0 auto;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-mv-menu]');
  const pemicu = document.querySelector<HTMLButtonElement>('[data-mv-menu-open]');

  if (dialog && pemicu) {
    let paddingAsli = '';

    const kunciScroll = (): void => {
      const gap = window.innerWidth - document.documentElement.clientWidth;
      paddingAsli = document.body.style.paddingRight;
      document.body.style.overflow = 'hidden';
      if (gap > 0) document.body.style.paddingRight = `${gap}px`;
    };

    const lepasScroll = (): void => {
      document.body.style.removeProperty('overflow');
      if (paddingAsli) document.body.style.paddingRight = paddingAsli;
      else document.body.style.removeProperty('padding-right');
    };

    pemicu.addEventListener('click', () => {
      if (dialog.open) return;
      dialog.showModal();
      pemicu.setAttribute('aria-expanded', 'true');
      kunciScroll();
    });

    dialog.querySelector('[data-mv-menu-close]')?.addEventListener('click', () => dialog.close());

    // Klik item navigasi menutup panel — kalau tidak, drawer menutupi
    // section tujuannya.
    dialog.querySelectorAll('[data-mv-menu-nav]').forEach((a) => {
      a.addEventListener('click', () => dialog.close());
    });

    // Klik backdrop (di luar panel) menutup — `::backdrop` mengirim
    // event-nya ke <dialog> itu sendiri.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // 'close' menangkap SEMUA jalur penutupan, termasuk Esc bawaan browser.
    dialog.addEventListener('close', () => {
      lepasScroll();
      pemicu.setAttribute('aria-expanded', 'false');
      pemicu.focus();
    });

    /* Pembungkus siklus Tab. <dialog> modal sudah membuat latar inert,
       tapi Chrome menyelipkan <body> sekali di antara elemen terakhir
       dan pertama sehingga satu tekanan Tab terasa "kosong". */
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;

      const fokusable = [
        ...dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ].filter((el) => el.offsetParent !== null);

      const pertama = fokusable[0];
      const terakhir = fokusable[fokusable.length - 1];
      if (!pertama || !terakhir) return;

      const aktif = document.activeElement;
      if (e.shiftKey && aktif === pertama) {
        e.preventDefault();
        terakhir.focus();
      } else if (!e.shiftKey && aktif === terakhir) {
        e.preventDefault();
        pertama.focus();
      }
    });
  }
</script>
