---
/**
 * Tab — ARIA tablist/tab/tabpanel dengan navigasi panah & deep link hash.
 *
 * BUKAN custom dropdown (aturan sprint 2/3). Panel diisi lewat named slot:
 *   <Tab tabs={[{ id: 'apparel', label: 'Apparel' }]} label="Kategori">
 *     <div slot="panel-apparel"> … </div>
 *   </Tab>
 *
 * Pembeda tab aktif memakai TIGA sinyal (AC T02.5 + §7.8): warna aksen,
 * weight 700, dan border bawah 2px. Warna tidak pernah sendirian.
 * Lebar tab dikunci ke lebar teks tebalnya (pseudo-element tersembunyi)
 * supaya perpindahan tab tidak menggeser layout.
 *
 * Props:
 *   tabs       TabItem[] — { id, label }. `id` juga jadi hash deep link.
 *   label      aria-label untuk tablist. WAJIB.
 *   defaultId  tab aktif awal. Default: tab pertama.
 *   class
 */
import type { TabItem } from './types';

interface Props {
  tabs: TabItem[];
  label: string;
  defaultId?: string;
  class?: string;
}

const { tabs, label, defaultId, class: className } = Astro.props;

const aktifId = defaultId && tabs.some((t) => t.id === defaultId) ? defaultId : tabs[0]?.id;
---

<div class:list={['mv-tabs', className]} data-mv-tabs>
  <div class="mv-tabs__listwrap">
    <div class="mv-tabs__list" role="tablist" aria-label={label}>
      {
        tabs.map((t) => {
          const aktif = t.id === aktifId;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              class="mv-tabs__tab"
              data-tab-id={t.id}
              aria-controls={`panel-${t.id}`}
              aria-selected={aktif ? 'true' : 'false'}
              tabindex={aktif ? 0 : -1}
            >
              <span class="mv-tabs__label" data-teks={t.label}>
                {t.label}
              </span>
            </button>
          );
        })
      }
    </div>
  </div>

  {
    tabs.map((t) => (
      <div
        role="tabpanel"
        id={`panel-${t.id}`}
        class="mv-tabs__panel"
        aria-labelledby={`tab-${t.id}`}
        tabindex="0"
        hidden={t.id !== aktifId}
      >
        <slot name={`panel-${t.id}`} />
      </div>
    ))
  }

  {
    /*
    Tanpa JavaScript, tab tidak bisa berpindah — kalau dibiarkan apa adanya,
    isi panel 2 & 3 hilang sepenuhnya bagi pengguna itu. Karena itu:
    daftar tab disembunyikan (kontrol yang tidak berfungsi lebih
    membingungkan daripada tidak ada) dan SELURUH panel ditumpuk terbuka.
    Panel tetap dirender `hidden` di server supaya versi ber-JS tidak
    berkedip saat memuat.
  */
  }
  <noscript>
    <style>
      .mv-tabs__listwrap {
        display: none;
      }
      .mv-tabs__panel[hidden] {
        display: block !important;
      }
    </style>
  </noscript>
</div>

<style>
  .mv-tabs__listwrap {
    /* Di mobile daftar tab bisa lebih lebar dari layar — digeser sendiri,
       tidak membuat halaman meluber. */
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .mv-tabs__list {
    display: flex;
    gap: var(--space-6);
    min-inline-size: max-content;
  }

  .mv-tabs__tab {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    border: 0;
    /* Sinyal 3: border bawah. Transparan saat tidak aktif supaya tinggi tetap. */
    border-block-end: 2px solid transparent;
    color: var(--color-text-2);
    cursor: pointer;
    padding-inline: 0;
    /* Target sentuh §7.8 */
    min-block-size: var(--tap-min);
    display: inline-flex;
    align-items: center;
    transition:
      color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease);
  }

  .mv-tabs__label {
    font-family: var(--font-display);
    font-size: var(--fs-body-m);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    /* Sinyal 2: weight. 600 → 700 saat aktif. */
    font-weight: 600;
    display: inline-grid;
  }

  /* Cadangkan lebar versi tebalnya supaya tab tidak bergeser saat aktif. */
  .mv-tabs__label::after {
    content: attr(data-teks);
    grid-area: 1 / 1;
    font-weight: 700;
    visibility: hidden;
    pointer-events: none;
    block-size: 0;
  }

  .mv-tabs__tab:hover {
    color: var(--color-text);
  }

  .mv-tabs__tab:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  /* ---------- state aktif: warna + weight + border ---------- */
  .mv-tabs__tab[aria-selected='true'] {
    color: var(--color-accent); /* sinyal 1 */
    border-block-end-color: var(--color-accent); /* sinyal 3 */
  }

  .mv-tabs__tab[aria-selected='true'] .mv-tabs__label {
    font-weight: 700; /* sinyal 2 */
  }

  .mv-tabs__panel {
    padding-block-start: var(--space-6);
  }

  .mv-tabs__panel[hidden] {
    display: none;
  }

  .mv-tabs__panel:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }
</style>

<script>
  /* Tanpa JS: tab pertama tampil, sisanya `hidden`. Konten panel lain tidak
     hilang dari DOM — hanya tersembunyi — sehingga tetap terindeks mesin cari. */
  class MvTabs {
    private tabs: HTMLButtonElement[];

    constructor(root: HTMLElement) {
      this.tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

      this.tabs.forEach((tab) => {
        tab.addEventListener('click', () => this.activate(tab, true));
        tab.addEventListener('keydown', (e) => this.onKeydown(e));
      });

      this.applyHash();
      window.addEventListener('hashchange', () => this.applyHash());
    }

    private applyHash(): void {
      const id = window.location.hash.replace(/^#/, '');
      if (!id) return;
      const target = this.tabs.find((t) => t.dataset.tabId === id);
      if (target) this.activate(target, false);
    }

    private activate(tab: HTMLButtonElement, fokus: boolean): void {
      for (const t of this.tabs) {
        const aktif = t === tab;
        t.setAttribute('aria-selected', aktif ? 'true' : 'false');
        t.tabIndex = aktif ? 0 : -1;

        const panelId = t.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (panel) panel.hidden = !aktif;
      }

      if (fokus) {
        tab.focus();
        const id = tab.dataset.tabId;
        // replaceState: deep link tetap bisa dibagikan tanpa menumpuk
        // riwayat dan tanpa lompatan scroll yang dipicu perubahan hash.
        if (id) window.history.replaceState(null, '', `#${id}`);
      }
    }

    private onKeydown(e: KeyboardEvent): void {
      const arah: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1 };
      const current = this.tabs.indexOf(e.currentTarget as HTMLButtonElement);
      if (current === -1) return;

      let next = -1;
      if (e.key in arah) {
        const delta = arah[e.key] ?? 0;
        next = (current + delta + this.tabs.length) % this.tabs.length;
      } else if (e.key === 'Home') {
        next = 0;
      } else if (e.key === 'End') {
        next = this.tabs.length - 1;
      }

      if (next === -1) return;
      const target = this.tabs[next];
      if (!target) return;

      e.preventDefault();
      this.activate(target, true);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-mv-tabs]').forEach((el) => new MvTabs(el));
</script>
