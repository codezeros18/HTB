---
/**
 * ClientLogo — satu sel kartu dalam grid "PORTOFOLIO" (S07).
 *
 * TIGA mode dalam wadah berukuran IDENTIK:
 *   - `more` diisi          → sel penutup "+ <teks> →" (referensi klien)
 *   - `izinTayang: true` + `logo` → <img> dinormalisasi (contain)
 *   - selain itu            → NAMA TEKS
 *
 * REDESIGN 2026-09-06 (permintaan klien, referensi dilampirkan): kartu
 * dibuat lebih tinggi & mengisi penuh kolom grid (dulu chip 160×80 yang
 * dipusatkan). Tema tetap milik proyek: chip terang, sudut KOTAK, glow
 * emas lembut saat hover.
 *
 * `alt` = nama organisasi, bukan "logo klien N".
 */
interface Props {
  nama?: string;
  logo?: string | null;
  izinTayang?: boolean;
  /** 5 logo hero dimuat eager; sisanya lazy. */
  hero?: boolean;
  /** Sel penutup "+ Banyak lagi" — mengganti isi chip dengan teks aksi. */
  more?: string | null;
  class?: string;
}

const {
  nama = '',
  logo = null,
  izinTayang = false,
  hero = false,
  more = null,
  class: className,
}: Props = Astro.props;

const tampilLogo = izinTayang && logo !== null;
---

<li class:list={['mv-client', more && 'mv-client--more', className]}>
  <div class="mv-client__chip">
    {
      more ? (
        <span class="mv-client__more">
          <span>+ {more}</span>
          <span class="mv-client__arrow" aria-hidden="true">
            &rarr;
          </span>
        </span>
      ) : tampilLogo ? (
        <img
          class="mv-client__img"
          src={logo}
          alt={nama}
          width="128"
          height="44"
          loading={hero ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <span class="mv-client__nama">{nama}</span>
      )
    }
  </div>
</li>

<style>
  .mv-client {
    list-style: none;
    display: flex;
  }

  /* Chip terang penuh-kolom, sudut KOTAK (tema proyek). Glow emas saat hover. */
  .mv-client__chip {
    inline-size: 100%;
    block-size: clamp(96px, 11vw, 124px);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;

    background-color: var(--color-chip);
    border: 0;
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.6);
    transition:
      transform var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mv-client:hover .mv-client__chip {
      transform: translateY(-3px);
      box-shadow:
        0 14px 34px -12px rgba(0, 0, 0, 0.65),
        0 0 34px -6px color-mix(in srgb, var(--color-accent) 60%, transparent);
    }
  }

  .mv-client__img {
    max-inline-size: 100%;
    max-block-size: 56px;
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
  }

  .mv-client__nama {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    line-height: 1.25;
    text-align: center;
    color: var(--color-chip-ink);
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  /* Sel penutup */
  .mv-client__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    color: var(--color-chip-ink);
  }

  .mv-client__arrow {
    transition: transform var(--dur-base) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mv-client--more:hover .mv-client__arrow {
      transform: translateX(4px);
    }
  }
</style>
