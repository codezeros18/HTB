---
/**
 * ClientLogo — satu sel portofolio dalam grid "PERNAH DIPERCAYA OLEH" (S07).
 *
 * DUA mode dalam wadah berukuran IDENTIK (BLUEPRINT §5.3 / §8 Section 6):
 *   - `izinTayang: true`  + `logo` → <img> dinormalisasi (contain, max-h 44px)
 *   - selain itu (kondisi SEKARANG: semua entri false) → NAMA TEKS Archivo 600
 *
 * AC T07.3: selama semua `izinTayang: false`, komponen ini merender NOL
 * `<img>`. Kotak tetap sama besar untuk kedua mode → grid seragam.
 *
 * AC T07.2: tinggi sel dikunci `--logo-box-h` (80px) untuk SEMUA sel di
 * SEMUA viewport — keseragaman ±0px secara konstruksi. Lebar mengecil
 * proporsional di mobile (grid `1fr`), tinggi tidak.
 *
 * Interaksi: TIDAK ADA. Bukan tautan, nol hover, nol filter grayscale
 * (BLUEPRINT §8 Section 6 — grayscale menghapus identitas warna & mati
 * di mobile). `alt` = nama organisasi, bukan "logo klien N" (AC T07.4).
 */
interface Props {
  nama: string;
  logo: string | null;
  izinTayang: boolean;
  /** 5 logo hero dimuat eager; sisanya lazy (BLUEPRINT §8 Section 6). */
  hero?: boolean;
  class?: string;
}

const { nama, logo, izinTayang, hero = false, class: className }: Props = Astro.props;

const tampilLogo = izinTayang && logo !== null;
---

<li class:list={['mv-client', className]}>
  <div class="mv-client__chip">
    {
      tampilLogo ? (
        <img
          class="mv-client__img"
          src={logo}
          alt={nama}
          width="128"
          height="44"
          loading={hero ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <span class="mv-client__nama">{nama}</span>
      )
    }
  </div>
</li>

<style>
  .mv-client {
    list-style: none;
    display: flex;
    justify-content: center;
  }

  /* REDESIGN 2026-08-31 — border putih dibuang. Tiap logo di CHIP TERANG
     rounded: logo berlatar putih (mayoritas aset) menyatu mulus, logo PNG
     transparan dapat alas bersih. Glow emas lembut saat hover. */
  .mv-client__chip {
    inline-size: 100%;
    max-inline-size: var(--logo-box-w);
    block-size: var(--logo-box-h);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;

    background-color: var(--color-chip);
    border: 0;
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.6);
    transition:
      transform var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mv-client:hover .mv-client__chip {
      transform: translateY(-3px);
      box-shadow:
        0 14px 34px -12px rgba(0, 0, 0, 0.65),
        0 0 34px -6px color-mix(in srgb, var(--color-accent) 60%, transparent);
    }
  }

  .mv-client__img {
    max-inline-size: 100%;
    max-block-size: 46px;
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
  }

  .mv-client__nama {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    text-align: center;
    color: var(--color-chip-ink); /* teks gelap di atas chip terang */
    overflow-wrap: anywhere;
    hyphens: auto;
  }
</style>
