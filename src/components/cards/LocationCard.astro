---
/**
 * LocationCard — satu tahap dalam rantai produksi bernomor (S08).
 * REDESIGN 2026-08-31 (permintaan klien, iterasi 2):
 *   - Peta TIDAK LAGI di balik tombol "Tampilkan peta" — otomatis dimuat
 *     begitu kartu mendekati layar (IntersectionObserver, lihat
 *     `src/scripts/location-maps.ts`), jadi sudah siap saat pengunjung
 *     sampai di section ini. Tombol "Buka di Google Maps" DIHAPUS —
 *     rute keluar sekarang ada di POPUP pin peta ("Rute di Google Maps →").
 *   - Ketiga kartu tinggi & lebar identik: `height:100%` (grid induk
 *     men-stretch baris) + alamat dikunci 2 baris (`-webkit-line-clamp`)
 *     + area peta `flex:1` menyerap sisa ruang.
 *   - Begitu peta hidup, blok alamat teks disembunyikan VISUAL (tetap ada
 *     di DOM untuk screen reader) — visual-driven.
 *
 * `deskripsiPeran`/`telepon` — [GAP], selalu null saat ini → tidak
 * dirender, jaga struktur kartu tetap ringkas & seragam.
 *
 * Markup alamat pakai `<address>` + `itemprop` (AC T08.3); `id={slug}`
 * cocok fragmen `@id` blok `LocalBusiness` di StructuredData.astro.
 */
interface Props {
  nomor: string;
  peran: string;
  alamat: string;
  slug: string;
  lat: number;
  lng: number;
  mapsUrl: string | null;
  class?: string;
}

const { nomor, peran, alamat, slug, lat, lng, mapsUrl, class: className }: Props = Astro.props;
---

<article
  class:list={['mv-loc', className]}
  id={slug}
  itemscope
  itemtype="https://schema.org/LocalBusiness"
>
  <div class="mv-loc__head">
    <span class="mv-loc__num t-tnum" aria-hidden="true">{nomor}</span>
    <h3 class="mv-loc__peran t-h3" itemprop="name">{peran}</h3>
  </div>

  <address
    class="mv-loc__addr t-body-s"
    itemprop="address"
    itemscope
    itemtype="https://schema.org/PostalAddress"
  >
    <span itemprop="streetAddress">{alamat}</span>
  </address>

  <div
    class="mv-loc__map"
    data-map-auto
    data-lat={lat}
    data-lng={lng}
    data-title={peran}
    data-address={alamat}
    data-maps-url={mapsUrl}
  >
    {/* Placeholder singkat sebelum Leaflet hidup — bukan kotak abu (guardrail 7). */}
    <div class="mv-loc__placeholder" aria-hidden="true">
      <svg viewBox="0 0 320 200" role="presentation">
        <rect width="320" height="200" class="mv-loc__placeholder-bg"></rect>
        <path
          d="M160 60c-14 0-25 11-25 25 0 18 25 45 25 45s25-27 25-45c0-14-11-25-25-25Z"
          class="mv-loc__placeholder-pin"></path>
        <circle cx="160" cy="84" r="7" class="mv-loc__placeholder-lubang"></circle>
      </svg>
    </div>

    {
      /* Jaring pengaman tanpa JS: satu-satunya jalan keluar peta kalau
        Leaflet tak pernah hidup. Nol dampak saat JS aktif — <noscript>. */
      mapsUrl && (
        <noscript>
          <a class="mv-loc__noscript-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            Buka peta di Google Maps →
          </a>
        </noscript>
      )
    }
  </div>
</article>

<style>
  .mv-loc {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    /* Tinggi PENUH baris grid (Location.astro men-stretch) — ketiga kartu
       selalu identik terlepas dari panjang alamat. */
    block-size: 100%;
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-surface);
  }

  .mv-loc__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex: 0 0 auto;
  }

  .mv-loc__num {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: var(--fw-display);
    line-height: 1;
    flex: 0 0 auto;
  }

  .mv-loc__peran {
    color: var(--color-text);
    margin: 0;
  }

  /* Dikunci 2 baris — panjang alamat beda-beda tidak lagi membuat
     tinggi kartu berbeda. */
  .mv-loc__addr {
    flex: 0 0 auto;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-text-2);
    font-style: normal;
  }

  /* Begitu peta hidup, teks alamat tak lagi diperlukan (visual-driven) —
     tapi TETAP ada di DOM untuk screen reader & SEO, hanya disembunyikan
     secara visual (bukan `display:none`, supaya tetap terumumkan). */
  .mv-loc[data-map-live] .mv-loc__addr {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .mv-loc__map {
    position: relative;
    flex: 1 1 auto;
    min-block-size: 200px;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .mv-loc__placeholder {
    position: absolute;
    inset: 0;
  }

  .mv-loc__placeholder svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .mv-loc__placeholder-bg {
    fill: var(--color-surface-alt);
  }

  .mv-loc__placeholder-pin {
    fill: var(--color-accent);
    opacity: 0.6;
  }

  .mv-loc__placeholder-lubang {
    fill: var(--color-surface);
    opacity: 0.6;
  }

  .mv-loc__noscript-link {
    position: absolute;
    inset-block-end: var(--space-3);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    color: var(--color-text);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-text);
    padding-block: var(--space-2);
    padding-inline: var(--space-4);
    text-decoration: none;
  }

  /* Leaflet ditaruh di sini oleh location-maps.ts. */
  .mv-loc__map :global(.mv-loc__leaflet) {
    position: absolute;
    inset: 0;
  }

  /* ---------- override minimal tema Leaflet supaya cocok kaca gelap ---------- */
  .mv-loc__map :global(.leaflet-popup-content-wrapper),
  .mv-loc__map :global(.leaflet-popup-tip) {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .mv-loc__map :global(.leaflet-popup-content) {
    font-family: var(--font-body);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    margin: var(--space-3);
  }

  .mv-loc__map :global(.leaflet-popup-content a) {
    color: var(--color-accent);
  }

  .mv-loc__map :global(.mv-loc__pin span) {
    display: block;
    inline-size: 22px;
    block-size: 22px;
    border-radius: 50% 50% 50% 0;
    background-color: var(--color-accent);
    border: 2px solid var(--color-accent-ink);
    transform: rotate(-45deg);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
</style>
