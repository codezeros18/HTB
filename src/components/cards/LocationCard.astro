---
/**
 * LocationCard — judul peran (gaya headline emas) DI ATAS, di tengah,
 * TERPISAH dari kartu; lalu kartu KOTAK berisi peta Leaflet penuh
 * edge-to-edge. REDESIGN 2026-09-06 (permintaan klien).
 *
 * Schema: wrapper terluar = `LocalBusiness` (itemscope); `<h3 itemprop=name>`
 * & `<address itemprop=address>` tetap di dalam scope itu walau `<h3>`
 * dirender di luar kotak secara visual. `id={slug}` cocok fragmen `@id`
 * blok `LocalBusiness` di StructuredData.astro.
 *
 * Peta dimuat otomatis saat mendekati layar (IntersectionObserver, lihat
 * `src/scripts/location-maps.ts`).
 */
interface Props {
  peran: string;
  alamat: string;
  slug: string;
  lat: number;
  lng: number;
  mapsUrl: string | null;
  class?: string;
}

const { peran, alamat, slug, lat, lng, mapsUrl, class: className }: Props = Astro.props;
---

<div
  class:list={['mv-loc', className]}
  id={slug}
  itemscope
  itemtype="https://schema.org/LocalBusiness"
>
  <h3 class="mv-loc__judul" itemprop="name">{peran}</h3>

  <div class="mv-loc__card">
    <address
      class="mv-loc__addr"
      itemprop="address"
      itemscope
      itemtype="https://schema.org/PostalAddress"
    >
      <span itemprop="streetAddress">{alamat}</span>
    </address>

    <div
      class="mv-loc__map"
      data-map-auto
      data-lat={lat}
      data-lng={lng}
      data-title={peran}
      data-address={alamat}
      data-maps-url={mapsUrl}
    >
      {/* Placeholder singkat sebelum Leaflet hidup — bukan kotak abu (guardrail 7). */}
      <div class="mv-loc__placeholder" aria-hidden="true">
        <svg viewBox="0 0 320 200" role="presentation">
          <rect width="320" height="200" class="mv-loc__placeholder-bg"></rect>
          <path
            d="M160 60c-14 0-25 11-25 25 0 18 25 45 25 45s25-27 25-45c0-14-11-25-25-25Z"
            class="mv-loc__placeholder-pin"></path>
          <circle cx="160" cy="84" r="7" class="mv-loc__placeholder-lubang"></circle>
        </svg>
      </div>

      {
        /* Jaring pengaman tanpa JS: satu-satunya jalan keluar peta kalau
          Leaflet tak pernah hidup. Nol dampak saat JS aktif — <noscript>. */
        mapsUrl && (
          <noscript>
            <a
              class="mv-loc__noscript-link"
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Buka peta di Google Maps →
            </a>
          </noscript>
        )
      }
    </div>
  </div>
</div>

<style>
  .mv-loc {
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  /* Judul peran — gaya headline emas (sama seperti SectionHeading), di
     tengah, TERPISAH di atas kotak. */
  .mv-loc__judul {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-accent);
    font-size: clamp(1.15rem, 2.4vw, 2rem);
  }

  /* Kotak peta — lebar = tinggi (ketiga kartu identik oleh konstruksi:
     grid `1fr` → lebar sama → tinggi sama). Peta mengisi PENUH.

     `z-index: 0` WAJIB: Leaflet memasang z-index internal sampai 1000
     (kontrol zoom, atribusi, pane). Tanpa stacking context di sini,
     angka-angka itu bocor ke root dan menutupi navbar (`.mv-nav`
     z-index 50). `z-index: 0` mengurung seluruh z-index Leaflet di
     level 0 — selalu di bawah navbar. */
  .mv-loc__card {
    position: relative;
    z-index: 0;
    inline-size: 100%;
    aspect-ratio: 1 / 1;
    min-block-size: 15rem;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-surface);
  }

  /* Alamat: tidak terlihat (peta = infonya), tapi tetap di DOM untuk
     screen reader + schema. */
  .mv-loc__addr {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    font-style: normal;
  }

  .mv-loc__map {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .mv-loc__placeholder {
    position: absolute;
    inset: 0;
  }

  .mv-loc__placeholder svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .mv-loc__placeholder-bg {
    fill: var(--color-surface-alt);
  }

  .mv-loc__placeholder-pin {
    fill: var(--color-accent);
    opacity: 0.6;
  }

  .mv-loc__placeholder-lubang {
    fill: var(--color-surface);
    opacity: 0.6;
  }

  .mv-loc__noscript-link {
    position: absolute;
    inset-block-end: var(--space-3);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    color: var(--color-text);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-text);
    padding-block: var(--space-2);
    padding-inline: var(--space-4);
    text-decoration: none;
  }

  /* Leaflet ditaruh di sini oleh location-maps.ts. */
  .mv-loc__map :global(.mv-loc__leaflet) {
    position: absolute;
    inset: 0;
  }

  /* ---------- override minimal tema Leaflet supaya cocok kaca gelap ---------- */
  .mv-loc__map :global(.leaflet-popup-content-wrapper),
  .mv-loc__map :global(.leaflet-popup-tip) {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .mv-loc__map :global(.leaflet-popup-content) {
    font-family: var(--font-body);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    margin: var(--space-3);
  }

  .mv-loc__map :global(.leaflet-popup-content a) {
    color: var(--color-accent);
  }

  .mv-loc__map :global(.mv-loc__pin span) {
    display: block;
    inline-size: 22px;
    block-size: 22px;
    border-radius: 50% 50% 50% 0;
    background-color: var(--color-accent);
    border: 2px solid var(--color-accent-ink);
    transform: rotate(-45deg);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
</style>
