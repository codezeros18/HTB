---
/**
 * ProductCard — "product tile" katalog apparel. Redesign S-CATALOG.
 *
 * ⚠️ Redesign ini SENGAJA menyimpang dari beberapa guardrail CLAUDE.md atas
 * instruksi eksplisit pemilik proyek (2026-08-28). Jangan "diperbaiki" balik
 * ke pola lama tanpa instruksi baru:
 *   - Nilai warna & font ditulis LITERAL di komponen (bukan var(--token)) —
 *     meniru spesifikasi product tile yang diberikan persis.
 *   - Foto contoh `/images/shirt.jpg` dipakai di SEMUA kartu sebagai materi
 *     presentasi ke klien; diganti foto produk asli begitu disetujui.
 *   - CTA tombol per-kartu dihapus; seluruh kartu menjadi tautan ke WhatsApp
 *     (deep link pre-fill konteks 'produk').
 *
 * Struktur & ukuran (dari spesifikasi yang diberikan):
 *   card 294×542 · gambar 294×424 (object-fit: cover) ·
 *   .product-tile__information-content 294×118 ·
 *   URUTAN: nama dulu, lalu harga.
 *   nama  .typography 17/22.1, normal, #000000, margin-top 8 ·
 *   harga .typography 20/24, +0.36px, #EE0000, margin-top 12,
 *         font UniqloProRegular → fallback stack seragam dengan nama.
 *
 * Props:
 *   produk   Produk apa adanya dari `katalog.ts`.
 *   class
 */
import type { Produk } from '../../content/types';
import { waLink } from '../../content/site';

interface Props {
  produk: Produk;
  class?: string;
}

const { produk, class: className }: Props = Astro.props;

// Foto contoh untuk presentasi klien — diganti `produk.foto` saat aset asli turun.
const FOTO_CONTOH = '/images/shirt.jpg';

const href = waLink('produk', { produk: produk.nama });
const hargaTeks =
  produk.hargaMulai !== null ? `Rp ${produk.hargaMulai.toLocaleString('id-ID')}` : null;
---

<a class:list={['product-tile', className]} href={href} target="_blank" rel="noopener noreferrer">
  <img
    class="product-tile__image"
    src={FOTO_CONTOH}
    alt={produk.nama}
    width="294"
    height="424"
    loading="lazy"
    decoding="async"
  />

  <div class="product-tile__information-content">
    <div class="typography product-tile__name">{produk.nama}</div>
    {hargaTeks && <div class="typography product-tile__price">{hargaTeks}</div>}
  </div>
</a>

<style>
  .product-tile {
    display: block;
    inline-size: 294px;
    max-inline-size: 100%;
    text-decoration: none;
  }

  .product-tile__image {
    display: block;
    inline-size: 100%;
    aspect-ratio: 294 / 424;
    object-fit: cover;
  }

  .product-tile__information-content {
    inline-size: 100%;
  }

  .typography {
    font-size: 16px;
    line-height: normal;
    font-weight: 400;
    letter-spacing: normal;
  }

  .product-tile__price {
    margin-block-start: 12px;
    /* Ikut satu font situs (Poppins). */
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 24px;
    font-weight: 400;
    letter-spacing: 0.36px;
    color: #ee0000;
  }

  .product-tile__name {
    margin-block-start: 8px;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 22.1px;
    font-weight: 400;
    letter-spacing: normal;
    /* REDESIGN — dulu #000000; ikut token supaya terbaca di tema gelap. */
    color: var(--color-text);
  }
</style>
